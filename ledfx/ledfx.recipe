[VERSION]
B_GITVER https://github.com/ledfx/ledfx

[INFO]
arch=amd64
excludefromall=1

[REQUIRED]
python3-virtualenv virtualenv gcc python3-dev portaudio19-dev virtualenv-make-relocatable-B_PF

[BUILD]
B_GET git https://github.com/ledfx/ledfx ledfx
cd ledfx
DEST=$B_INSTALLDIR/opt/ledfx
virtualenv  -p python3 $DEST
source $DEST/bin/activate
pip install -r requirements.txt
python -m pip install .
#virtualenv --relocatable -p python3 $DEST
#sed -i "s#$B_INSTALLDIR##" $DEST/bin/activate*
deactivate
virtualenv-make-relocatable $DEST

[PKG]
type=deb
torepo=y

[DEB]
Package: ledfx
Version: B_VERSION
Section: ledfx
Priority: optional
Architecture: B_ARCH
Maintainer: B_MAIL
Description: ledfx saver custom B_ORG build
Homepage: https://github.com/ledfx/ledfx
Depends: python3,libportaudio2

[SECURITY]
# Findings from security-scan of cached sources; suppressed so
# vulnscan=enforce / srcguard=enforce builds pass. Review periodically;
# new findings still fail the build until reviewed.
vulnscan-ignore=GHSA-2fqr-mr3j-6wp8,GHSA-2wc2-fm75-p42x,GHSA-3936-cmfr-pm3m,GHSA-3x9g-8vmp-wqvf,GHSA-45hq-cxwh-f6vc,GHSA-4fvr-rgm6-gqmc,GHSA-4m7w-qmgq-4wj5,GHSA-4x4j-2g7c-83w6,GHSA-537c-gmf6-5ccf,GHSA-5x94-69rx-g8h2,GHSA-62p4-gmf7-7g93,GHSA-63hw-fmq6-xxg2,GHSA-65pc-fj4g-8rjx,GHSA-6r8x-57c9-28j4,GHSA-6v7p-g79w-8964,GHSA-6w46-j5rx-g56g,GHSA-82w8-qh3p-5jfq,GHSA-836r-79rf-4m37,GHSA-86qp-5c8j-p5mr,GHSA-8v84-f9pq-wr9x,GHSA-9663-mqmp-p9mm,GHSA-9hw9-ch79-4vh6,GHSA-9pgc-3ccv-5297,GHSA-9x8q-7h8h-wcw9,GHSA-cq5v-8q36-5273,GHSA-cx3h-4qpv-8hc9,GHSA-fj7v-r99m-22gq,GHSA-g3cq-j2xw-wf74,GHSA-g6cj-pr64-35w5,GHSA-h35f-9h28-mq5c,GHSA-hg6j-4rv6-33pg,GHSA-hpj7-wq8m-9hgp,GHSA-jg22-mg44-37j8,GHSA-jjj6-mw9f-p565,GHSA-jp82-jpqv-5vv3,GHSA-jwv3-5hgf-82ww,GHSA-m2h6-j472-rp4c,GHSA-m6qw-4cw2-hm4m,GHSA-mf9v-mfxr-j63j,GHSA-mfx4-hv73-q22v,GHSA-mgf9-4vpg-hj56,GHSA-mq44-7p77-q5h7,GHSA-p423-j2cm-9vmq,GHSA-pg7v-jwj7-p798,GHSA-phj9-mv4w-65pm,GHSA-phvx-9mgw-67r5,GHSA-pw6j-qg29-8w7f,GHSA-qc2x-6f54-m6h9,GHSA-qccp-gfcp-xxvc,GHSA-rfg2-pjw2-56x2,GHSA-vjc4-5qp5-m44j,GHSA-wqp7-x3pw-xc5r,GHSA-x746-7m8f-x49c,GHSA-xcgm-r5h9-7989,GHSA-xj96-63gp-2gmr,PYSEC-2026-141,PYSEC-2026-142,PYSEC-2026-161,PYSEC-2026-1845,PYSEC-2026-2104,PYSEC-2026-2105,PYSEC-2026-2106,PYSEC-2026-2107,PYSEC-2026-2108,PYSEC-2026-2109,PYSEC-2026-2110,PYSEC-2026-2111,PYSEC-2026-2112,PYSEC-2026-2113,PYSEC-2026-2120,PYSEC-2026-2121,PYSEC-2026-2132,PYSEC-2026-215,PYSEC-2026-2253,PYSEC-2026-2254,PYSEC-2026-2255,PYSEC-2026-2256,PYSEC-2026-2257,PYSEC-2026-2280,PYSEC-2026-2281,PYSEC-2026-237,PYSEC-2026-248,PYSEC-2026-249,PYSEC-2026-3071,PYSEC-2026-3072,PYSEC-2026-3387,PYSEC-2026-3388,PYSEC-2026-3389,PYSEC-2026-3435,PYSEC-2026-3436,PYSEC-2026-3437,PYSEC-2026-3438,PYSEC-2026-3439,PYSEC-2026-3447,PYSEC-2026-3451,PYSEC-2026-3452,PYSEC-2026-3453,PYSEC-2026-3454,PYSEC-2026-3493,PYSEC-2026-3494,PYSEC-2026-3495,PYSEC-2026-3496,PYSEC-2026-3545,PYSEC-2026-3546,PYSEC-2026-3547,PYSEC-2026-3552,PYSEC-2026-3553,PYSEC-2026-3554,PYSEC-2026-36,PYSEC-2026-3625
