[INFO]
arch=amd64
gittag=upmpdcli-v$B_VERSION

[VERSION]
B_GITVER -F upmpdcli-v https://framagit.org/medoc92/upmpdcli.git/

[REQUIRED]
autoconf g++ pkg-config libtool libmpdclient-dev libmicrohttpd-dev libjsoncpp-dev make libnpupnp-B_PF libupnpp-B_PF libcurl4-openssl-dev meson libexpat1-dev

[BUILD]
B_GET git https://framagit.org/medoc92/upmpdcli upmpdcli
cd upmpdcli
git checkout upmpdcli-v${B_VERSION}
#./autogen.sh
#./configure --prefix=/usr --sysconfdir=/etc
#make -j $(nproc)
#make install DESTDIR=$B_INSTALLDIR
#mv $B_INSTALLDIR/etc/upmpdcli.conf $B_INSTALLDIR/etc/upmpdcli.conf.example
#mkdir -p "$B_INSTALLDIR/lib/systemd/system"
#cp debian/upmpdcli.service "$B_INSTALLDIR/lib/systemd/system"
meson setup --prefix=/usr --sysconfdir=/etc builddir .
cd builddir
ninja
meson install --destdir $B_INSTALLDIR
cd ..
rm $B_INSTALLDIR/etc/upmpdcli.conf
mv src/upmpdcli.conf-dist $B_INSTALLDIR/etc/upmpdcli.conf.example
mkdir -p "$B_INSTALLDIR/lib/systemd/system"
cp debian/upmpdcli.service "$B_INSTALLDIR/lib/systemd/system"

[PKG]
type=deb
torepo=y

[DEB]
Package: upmpdcli
Version: B_VERSION
Section: upmpdcli
Priority: optional
Architecture: B_ARCH
Maintainer: B_MAIL
Description: upmpdcli custom B_ORG build
Homepage: https://framagit.org/medoc92/upmpdcli
Depends: libnpupnp-B_PF, libupnpp-B_PF, libjsoncpp26, libmicrohttpd12

[SECURITY]
# Findings from security-scan of cached sources; suppressed so
# vulnscan=enforce / srcguard=enforce builds pass. Review periodically;
# new findings still fail the build until reviewed.
srcguard-ignore=upmpdcli/meson.build,upmpdcli/rpm/upmpdcli.spec
