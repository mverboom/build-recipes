[INFO]
arch=amd64

[VERSION]
B_GITVER https://github.com/prefix-dev/pixi/

[REQUIRED]
rustc-B_PF gcc

[BUILD]
B_GET git https://github.com/prefix-dev/pixi pixi
cd pixi
git checkout v${B_VERSION}
cargo update quinn-proto --precise 0.11.15
cargo build --release
mkdir -p $B_INSTALLDIR/usr/bin
cp target/release/pixi $B_INSTALLDIR/usr/bin

[PKG]
type=deb
torepo=y

[DEB]
Package: pixi
Version: B_VERSION
Section: pixi
Priority: optional
Architecture: B_ARCH
Maintainer: B_MAIL
Description: pixi custom B_ORG build
Homepage: https://github.com/prefix-dev/pixi/

[SECURITY]
# Findings from security-scan of cached sources; suppressed so
# vulnscan=enforce / srcguard=enforce builds pass. Review periodically;
# new findings still fail the build until reviewed.
vulnscan-ignore=GHSA-3rjw-m598-pq24,GHSA-4w2j-m93h-cj5j,GHSA-xwfj-jgwm-7wp5,RUSTSEC-2020-0016,RUSTSEC-2023-0071,RUSTSEC-2024-0320,RUSTSEC-2024-0384,RUSTSEC-2025-0055,RUSTSEC-2026-0173,RUSTSEC-2026-0185,RUSTSEC-2026-0186,RUSTSEC-2026-0194,RUSTSEC-2026-0195,RUSTSEC-2026-0204,RUSTSEC-2026-0221,RUSTSEC-2026-0233,RUSTSEC-2026-0234,RUSTSEC-2026-0235,RUSTSEC-2026-0253,RUSTSEC-2026-0258
