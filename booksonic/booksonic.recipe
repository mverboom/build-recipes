[VERSION]
B_GITHUBREL https://github.com/popeen/Booksonic-Air

[INFO]
arch=amd64

[BUILD]
B_GET http https://github.com/popeen/Booksonic-Air/releases/download/v$B_VERSION/booksonic.war booksonic.war
mkdir -p $B_INSTALLDIR/opt/booksonic
mv booksonic.war $B_INSTALLDIR/opt/booksonic

[PKG]
type=deb
torepo=y

[DEB]
Package: booksonic
Version: B_VERSION
Section: booksonic
Priority: optional
Architecture: B_ARCH
Maintainer: B_MAIL
Description: Booksonic custom B_ORG build
Homepage: https://booksonic.org/
Depends: openjdk-11-jre-headless,ffmpeg

[SECURITY]
# Findings from security-scan of cached sources; suppressed so
# vulnscan=enforce / srcguard=enforce builds pass. Review periodically;
# new findings still fail the build until reviewed.
vulnscan-ignore=GHSA-24rp-q3w6-vc56,GHSA-337m-mw94-2v6g,GHSA-562r-vg33-8x8h,GHSA-673j-qm5f-xpv8,GHSA-727h-hrw8-jg8q,GHSA-77xx-rxvh-q682,GHSA-88cc-g835-76rp,GHSA-98qh-xjc8-98pq,GHSA-9w38-p64v-xpmv,GHSA-c438-6f6r-pg8w,GHSA-g76j-4cxx-23h9,GHSA-hfrx-6qgj-fp6c,GHSA-hqw5-62gp-rqgm,GHSA-j288-q9x7-2f5v,GHSA-m6vm-37g8-gqvh,GHSA-q5v2-2v66-6hwm,GHSA-r38f-c4h4-hqq2,GHSA-v7wg-cpwc-24m4,GHSA-vv7r-c36w-3prj,GHSA-wxr5-93ph-8wr9,GHSA-xj57-8qj4-c4m6,GHSA-xjp4-hw94-mvp5
