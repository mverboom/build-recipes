[INFO]
arch=amd64

[VERSION]
B_GITVER https://github.com/node-red/node-red

[REQUIRED]
nodejs-lts-B_PF g++ make

[BUILD]
B_GET git https://github.com/node-red/node-red nodered
cd nodered
git checkout tags/$B_VERSION
npm install
npm run build
rm -rf *.md .git* .nodemonignore package.json package-lock.json .travis.yml Gruntfile.js .jshintrc jsdoc.json LICENSE test
mkdir -p $B_INSTALLDIR/opt/node-red $B_INSTALLDIR/usr/bin
tar cf - . | ( cd $B_INSTALLDIR/opt/node-red ; tar xf - )
cd $B_INSTALLDIR/usr/bin
ln -s /opt/node-red/packages/node_modules/node-red/bin/node-red-pi node-red

[PKG]
type=deb
torepo=y

[DEB]
Package: node-red
Version: B_VERSION
Section: nodered
Priority: optional
Architecture: B_ARCH
Maintainer: B_MAIL
Description: Node RED custom B_ORG build
Homepage: http://nodered.org/
Depends: nodejs-lts-B_PF

[DEB BOOKWORM]
Package: node-red
Version: B_VERSION
Section: nodered
Priority: optional
Architecture: B_ARCH
Maintainer: B_MAIL
Description: Node RED custom B_ORG build
Homepage: http://nodered.org/
Depends: nodejs-lts-B_PF

[SECURITY]
# Findings from security-scan of cached sources; suppressed so
# vulnscan=enforce / srcguard=enforce builds pass. Review periodically;
# new findings still fail the build until reviewed.
vulnscan-ignore=GHSA-22jq-vg5j-6vgg,GHSA-2v8p-3f2j-5mp7,GHSA-3rrr-jr9j-h3q3,GHSA-4xrf-jv44-h6hh,GHSA-55q2-fjhq-7xh7,GHSA-5c6j-r48x-rmvq,GHSA-5p4m-2wfm-xmqj,GHSA-6x64-9x62-f2gx,GHSA-73rr-hh4g-fpgx,GHSA-7p8r-x3mc-p8w7,GHSA-86vw-mfpg-wwv9,GHSA-8xcm-r25x-g524,GHSA-c4c3-pg64-4m4v,GHSA-m8rv-5g2x-5cg5,GHSA-mh99-v99m-4gvg,GHSA-mwp4-54f8-5fhr,GHSA-q89c-q3h5-w34g,GHSA-qj8w-gfj5-8c6v,GHSA-r292-9mhp-454m,GHSA-rgw5-rvv9-x895,GHSA-rhh3-jpg6-66xh,GHSA-v3r7-h72x-cjcm
