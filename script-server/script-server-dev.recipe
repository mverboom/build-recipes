[VERSION]
B_GITHUBVER https://github.com/bugy/script-server

[INFO]
arch=amd64

[REQUIRED]
python3 nodejs-lts-B_PF

[BUILD]
B_GET git https://github.com/bugy/script-server script-server
cd script-server
DEST=$B_INSTALLDIR/opt/script-server-dev
mkdir -p "$DEST"
# Apply local patches BEFORE the frontend build (backend Python + web-src):
#   apply-title-prefix.sh      runtime-configurable tab title prefix via
#                              SCRIPT_SERVER_TITLE_PREFIX env var
#   apply-deeplink-prefill.sh  deep-link URL parameter prefill survives the
#                              dependent-values wipe race
#   apply-keep-last-finished.sh keep the most recent finished execution per
#                              script visible in the live tabs (browser session)
$B_FILES/apply-title-prefix.sh
$B_FILES/apply-deeplink-prefill.sh
$B_FILES/apply-keep-last-finished.sh
# Build web/ from web-src of the same git checkout. Do NOT use
# `tools/init.py --no-npm`: that downloads the prebuilt web bundle from the
# GitHub `dev` release, which goes stale (it was last published 2025-12-26)
# and then no longer matches the backend (e.g. history pagination in 2026-08
# broke the History page with "e.sort is not a function").
# Vue CLI 4 / webpack 4 needs the legacy OpenSSL provider on Node 17+
# (same NODE_OPTIONS the upstream .travis.yml uses on Node 20).
export NODE_OPTIONS=--openssl-legacy-provider
tools/init.py
mkdir -p "$B_INSTALLDIR"/etc/script-server-dev/theme
sed -i 's#"filename": "logs/server.log"#"filename": "/var/log/script-server-dev/server.log"#' conf/logging.json
mv conf/* "$B_INSTALLDIR"/etc/script-server-dev
cp samples/themes/orange/theme.css "$B_INSTALLDIR"/etc/script-server-dev/theme/theme.css
rmdir conf
rm -rf logs web-src temp tools
rm requirements.txt
mv * "$DEST"

[PKG]
type=deb
torepo=y

[DEB]
Package: script-server-dev
Version: B_VERSION
Section: script-server-dev
Priority: optional
Architecture: B_ARCH
Maintainer: B_MAIL
Description: script-server-dev custom B_ORG build
Homepage: https://github.com/bugy/script-server
Depends: python3-tornado,python3-pycurl
