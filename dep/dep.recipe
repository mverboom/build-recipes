[INFO]
arch=amd64

[VERSION]
B_GITVER https://github.com/golang/dep

[REQUIRED]
golang-B_PF

[BUILD]
B_GET git https://github.com/golang/dep dep
cd dep
git checkout tags/v$B_VERSION
mkdir -p $B_INSTALLDIR/opt/dep/bin
INSTALL_DIRECTORY=$B_INSTALLDIR/opt/dep/bin ./install.sh
B_LINKFILES /opt/dep/bin /usr/bin

[PKG]
type=deb
torepo=y

[DEB]
Package: dep
Version: B_VERSION
Section: dep
Priority: optional
Architecture: B_ARCH
Maintainer: B_MAIL
Description: Dep custom B_ORG build
Homepage: https://github.com/golang/dep

[SECURITY]
# Findings from security-scan of cached sources; suppressed so
# vulnscan=enforce / srcguard=enforce builds pass. Review periodically;
# new findings still fail the build until reviewed.
vulnscan-ignore=GHSA-23c5-xmqv-rm74,GHSA-257v-vj4p-3w2h,GHSA-29mw-wpgm-hmr9,GHSA-2g4f-4pwh-qvx6,GHSA-2m39-62fm-q8r3,GHSA-35jh-r3h4-6jhm,GHSA-36m4-6v6m-4vpr,GHSA-37ch-88jc-xwx2,GHSA-394c-5j6w-4xmx,GHSA-3jxr-9vmj-r5cp,GHSA-3ppc-4f35-3m26,GHSA-44pw-h2cw-w3vq,GHSA-4rq4-32rv-6wp6,GHSA-4xc9-xhrj-v574,GHSA-64g7-mvw6-v9qj,GHSA-662x-fhqg-9p8v,GHSA-67hx-6x53-jw92,GHSA-6rw7-vpxm-498p,GHSA-72xf-g2v4-qvf3,GHSA-78cj-fxph-m83p,GHSA-7r86-cg39-jmmj,GHSA-7wwv-vh3v-89cq,GHSA-896r-f27r-55mw,GHSA-9c47-m6qq-7p4h,GHSA-9vvw-cc9w-f27h,GHSA-9wv6-86v2-598j,GHSA-c2qf-rxjj-qqgw,GHSA-c429-5p7v-vgjp,GHSA-cf4h-3jhx-xvhq,GHSA-cm22-4g7w-348p,GHSA-f23m-r3pf-42rh,GHSA-f886-m6hf-6m8v,GHSA-f8q6-p94x-37v3,GHSA-fjxv-7rqg-78g4,GHSA-fvqr-27wr-82fm,GHSA-gxpj-cx7g-858c,GHSA-hj48-42vr-x3v9,GHSA-hmw2-7cc7-3qxx,GHSA-hrpp-h998-j3pp,GHSA-jf85-cpcp-j695,GHSA-jp4x-w63m-7wgm,GHSA-m6fv-jmcg-4jfg,GHSA-mf6x-7mm4-x2g7,GHSA-mh99-v99m-4gvg,GHSA-p6mc-m468-83gw,GHSA-p8p7-x288-28g6,GHSA-pxg6-pf52-xh8x,GHSA-q22g-8fr4-qpj4,GHSA-qpx9-hpmf-5gmw,GHSA-qrmc-fj45-qfc2,GHSA-qw6h-vgh9-j6wx,GHSA-qwcr-r2fm-qrc7,GHSA-r5fr-rjxr-66jc,GHSA-r683-j2x4-v87g,GHSA-rgw5-rvv9-x895,GHSA-rhx6-c78j-4q9w,GHSA-rq8g-5pc5-wrhr,GHSA-rv95-896h-c2vc,GHSA-v2p6-4mp7-3r9v,GHSA-v422-hmwv-36x6,GHSA-v6h2-p8h4-qcjw,GHSA-v88g-cgmw-v5xw,GHSA-vfrc-7r7c-w9mx,GHSA-vh95-rmgr-6w4m,GHSA-w5hq-g745-h8pq,GHSA-x5rq-j2xg-h7qm,GHSA-xvch-5gv4-984h,GHSA-xxjr-mmjv-4gpg
