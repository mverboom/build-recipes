[VERSION]
B_GITVER -e -pre -f 0.11 https://github.com/NanoVNA-Saver/nanovna-saver

[INFO]
arch=amd64

[REQUIRED]
python3-venv

[BUILD DEBIAN BOOKWORM]
B_GET git https://github.com/NanoVNA-Saver/nanovna-saver nanovna-saver
cd nanovna-saver
git checkout v$B_VERSION
touch CHANGELOG.md
DEST=$B_INSTALLDIR/opt/nanovna-saver
python3 -m venv $DEST
. $DEST/bin/activate
python3 -m pip install .
deactivate
pushd "$DEST/bin"
shopt -s extglob
sed -i "s|$DEST|/opt/nanovna-saver|g" !(__pycache__)
popd

[PKG]
type=deb
torepo=y

[DEB]
Package: nanovna-saver
Version: B_VERSION
Section: nanovna-saver
Priority: optional
Architecture: B_ARCH
Maintainer: B_MAIL
Description: NanoVNA saver custom B_ORG build
Homepage: https://github.com/NanoVNA-Saver/nanovna-saver

[SECURITY]
# Findings from security-scan of cached sources; suppressed so
# vulnscan=enforce / srcguard=enforce builds pass. Review periodically;
# new findings still fail the build until reviewed.
vulnscan-ignore=GHSA-4gg8-gxpx-9rph,GHSA-597g-3phw-6986,GHSA-5rjg-fvgr-3xxf,GHSA-65pc-fj4g-8rjx,GHSA-6w46-j5rx-g56g,GHSA-8qf3-x8v5-2pj8,GHSA-h35f-9h28-mq5c,GHSA-pjjw-68hj-v9mw,GHSA-pqhf-p39g-3x64,GHSA-qmgc-5h2g-mvrw,GHSA-w476-p2h3-79g9,GHSA-w853-jp5j-5j7f,PYSEC-2025-49,PYSEC-2026-1374,PYSEC-2026-1375,PYSEC-2026-1845,PYSEC-2026-2001,PYSEC-2026-2009,PYSEC-2026-215,PYSEC-2026-2295,PYSEC-2026-3447
