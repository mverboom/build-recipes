[INFO]
arch=amd64

[VERSION]
B_GITVER https://github.com/sammcj/gollama

[REQUIRED]
golang-B_PF make fzf

[BUILD]
export GOROOT=/opt/go
export PATH=${PATH}:${GOROOT}/bin
B_GET git https://github.com/sammcj/gollama gollama
cd gollama
git checkout v$B_VERSION
export PATH=/opt/go/bin:$PATH
export GOPATH=$(pwd)
make build
mkdir -p "$B_INSTALLDIR/usr/bin"
cp gollama "$B_INSTALLDIR/usr/bin"

[PKG]
type=deb
torepo=y

[DEB]
Package: gollama
Version: B_VERSION
Section: gollama
Priority: optional
Architecture: B_ARCH
Maintainer: B_MAIL
Homepage: https://github.com/sammcj/gollama
Description: gollama B_PF custom build

[SECURITY]
# Findings from security-scan of cached sources; suppressed so
# vulnscan=enforce / srcguard=enforce builds pass. Review periodically;
# new findings still fail the build until reviewed.
vulnscan-ignore=GO-2025-3557,GO-2025-3558,GO-2025-3559,GO-2025-3582,GO-2025-3689,GO-2025-3695,GO-2025-3824,GO-2025-4251,GO-2026-5750,GO-2026-5932,GO-2026-5970
