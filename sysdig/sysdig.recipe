[INFO]
arch=amd64

[VERSION]
B_GITVER -e agent https://github.com/draios/sysdig

[REQUIRED]
cmake g++ clang bpftool

[BUILD]
B_GET git https://github.com/draios/sysdig sysdig
cd sysdig
git checkout $B_VERSION
mkdir -p build; cd build
cmake -DCMAKE_INSTALL_PREFIX=/usr -DBUILD_DRIVER=OFF ..
make
make DESTDIR=$B_INSTALLDIR install

# Drop the "+driver" suffix the upstream install uses, so the module sources
# land in the usual /usr/src/scap-<version>. The dkms hook that builds them is a
# static file in sysdig.files and picks the version up at install time.
dorg="$(ls -d $B_INSTALLDIR/usr/src/scap-*/)"
mv "$dorg" "${dorg/+driver/}"

[PKG]
type=deb
torepo=y

[DEB]
Package: sysdig
Version: B_VERSION
Section: sysdig
Priority: optional
Architecture: B_ARCH
Maintainer: B_MAIL
Description: sysdig custom B_ORG build
Homepage: https://github.com/draios/sysdig
Depends: dkms
