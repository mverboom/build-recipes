[INFO]
arch=amd64

[VERSION]
B_GITVER https://github.com/warmcat/libwebsockets

[REQUIRED]
cmake libgnutls28-dev g++

[BUILD]
B_GET git https://github.com/warmcat/libwebsockets libwebsockets
cd libwebsockets
git checkout v$B_VERSION
mkdir build
cd build
cmake -DCMAKE_INSTALL_PREFIX:PATH=/opt/libwebsockets ..
make -j $(nproc)
make install DESTDIR=$B_INSTALLDIR

[PKG]
type=deb
torepo=y

[DEB]
Package: libwebsockets
Version: B_VERSION
Section: libwebsockets
Priority: optional
Architecture: B_ARCH
Maintainer: B_MAIL
Description: Libwebsockets custom B_ORG build
Homepage: https://libwebsockets.org/
Depends: libgnutls30t64

[SECURITY]
# Findings from security-scan of cached sources; suppressed so
# vulnscan=enforce / srcguard=enforce builds pass. Review periodically;
# new findings still fail the build until reviewed.
srcguard-ignore=libwebsockets/scripts/esp32.mk,libwebsockets/test-apps/android/app/src/main/jni/Application.mk,libwebsockets/test-apps/android/app/src/main/jni/NativeLibs.mk
