[INFO]
arch=all

[VERSION]
B_GITVER https://github.com/gchq/CyberChef

[REQUIRED]
nodejs npm make g++ unzip

[BUILD]
B_GET git https://github.com/gchq/CyberChef cyberchef
cd cyberchef
git checkout v$B_VERSION
npm config set registry https://registry.npmjs.org/
npm install
./node_modules/grunt/bin/grunt prod

cd build/prod
mkdir -p $B_INSTALLDIR/opt/cyberchef
unzip CyberChef_v$B_VERSION.zip -d $B_INSTALLDIR/opt/cyberchef
mv $B_INSTALLDIR/opt/cyberchef/CyberChef_v$B_VERSION.html $B_INSTALLDIR/opt/cyberchef/CyberChef.html

[PKG]
type=deb
torepo=y

[DEB]
Package: cyberchef
Version: B_VERSION
Section: cyberchef
Priority: optional
Architecture: B_ARCH
Maintainer: B_MAIL
Description: cyberchef custom B_ORG build
Homepage: https://github.com/gchq/CyberChef

[SECURITY]
# Findings from security-scan of cached sources; suppressed so
# vulnscan=enforce / srcguard=enforce builds pass. Review periodically;
# new findings still fail the build until reviewed.
vulnscan-ignore=GHSA-23c5-xmqv-rm74,GHSA-3ppc-4f35-3m26,GHSA-4rq4-32rv-6wp6,GHSA-5c6j-r48x-rmvq,GHSA-5v7r-6r5c-r473,GHSA-64g7-mvw6-v9qj,GHSA-7r86-cg39-jmmj,GHSA-848j-6mx2-7j84,GHSA-mh99-v99m-4gvg,GHSA-qj8w-gfj5-8c6v,GHSA-rgw5-rvv9-x895,GHSA-w5hq-g745-h8pq,GHSA-xcpc-8h2w-3j85
