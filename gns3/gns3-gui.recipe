[INFO]
arch=amd64
excludefromall=1

[VERSION]
B_GITVER -e a https://github.com/GNS3/gns3-gui

[REQUIRED]
python3-pip python3-venv

[BUILD]
DEST=$B_INSTALLDIR/opt/gns3-gui
mkdir -p "$DEST"
python3 -m venv "$DEST"
. $DEST/bin/activate
pip3 install gns3-gui==$B_VERSION
pushd "$DEST/bin"
shopt -s extglob
sed -i "s|$DEST|/opt/gns3-gui|g" !(__pycache__)
popd
B_LINKFILE /opt/gns3-gui/bin/gns3 /usr/bin

[PKG]
type=deb
torepo=y

[DEB]
Package: gns3-gui
Version: B_VERSION
Section: gns3-gui
Priority: optional
Architecture: B_ARCH
Maintainer: B_MAIL
Description: gns3-gui custom B_ORG build
Homepage: https://github.com/GNS3/gns3-gui
Depends: python3,gns3-server-B_PF

[SECURITY]
# Findings from security-scan of cached sources; suppressed so
# vulnscan=enforce / srcguard=enforce builds pass. Review periodically;
# new findings still fail the build until reviewed.
vulnscan-ignore=GHSA-5239-wwwm-4pmq,GHSA-6w46-j5rx-g56g,GHSA-mrwq-x4v8-fh7p,PYSEC-2023-117,PYSEC-2026-1845,PYSEC-2026-2987
