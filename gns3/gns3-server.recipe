[INFO]
arch=amd64

[VERSION]
B_GITVER -e '.*[ab].*' https://github.com/GNS3/gns3-server gns3-server

[REQUIRED]
python3-setuptools python3-pip python3-venv

[BUILD]
DEST=$B_INSTALLDIR/opt/gns3-server
mkdir -p $DEST
python3 -m venv "$DEST"
. $DEST/bin/activate
pip3 install gns3-server==$B_VERSION
pushd "$DEST/bin"
shopt -s extglob
sed -i "s|$DEST|/opt/gns3-server|g" !(__pycache__)
popd
B_LINKFILE /opt/gns3-server/bin/gns3server /usr/bin

[PKG]
type=deb
torepo=y

[DEB]
Package: gns3-server
Version: B_VERSION
Section: gns3-server
Priority: optional
Architecture: B_ARCH
Maintainer: B_MAIL
Description: gns3-server custom B_ORG build
Homepage: https://github.com/GNS3/gns3-server
Depends: python3,vpcs-B_PF,ubridge-B_PF,iou-B_PF,libvirt0

[SECURITY]
# Findings from security-scan of cached sources; suppressed so
# vulnscan=enforce / srcguard=enforce builds pass. Review periodically;
# new findings still fail the build until reviewed.
vulnscan-ignore=GHSA-5239-wwwm-4pmq,GHSA-65pc-fj4g-8rjx,GHSA-6w46-j5rx-g56g,GHSA-mrwq-x4v8-fh7p,PYSEC-2023-117,PYSEC-2026-1845,PYSEC-2026-215,PYSEC-2026-2987
