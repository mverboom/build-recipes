[INFO]
arch=amd64
excludefromall=1

[VERSION]
B_GITVER https://github.com/badaix/snapweb

[REQUIRED]
typescript-B_PF

[BUILD]
B_GET git https://github.com/badaix/snapweb snapweb
cd snapweb
npm install
npm ci
npm run build
mkdir -p $B_INSTALLDIR/opt/snapweb
cd dist
tar cf - . | tar -C $B_INSTALLDIR/opt/snapweb -xf -

[PKG]
type=deb
torepo=y

[DEB]
Package: snapweb
Version: B_VERSION
Section: snapweb
Priority: optional
Architecture: B_ARCH
Maintainer: B_MAIL
Description: snapweb custom B_ORG build
Homepage: https://github.com/badaix/snapweb

[SECURITY]
# Findings from security-scan of cached sources; suppressed so
# vulnscan=enforce / srcguard=enforce builds pass. Review periodically;
# new findings still fail the build until reviewed.
vulnscan-ignore=GHSA-23c5-xmqv-rm74,GHSA-25h7-pfq9-p65f,GHSA-28wg-ghj8-5hjv,GHSA-2g4f-4pwh-qvx6,GHSA-2v37-7h3g-55p8,GHSA-3jxr-9vmj-r5cp,GHSA-3ppc-4f35-3m26,GHSA-3v7f-55p6-f55p,GHSA-48c2-rrv3-qjmp,GHSA-4c8g-83qw-93j6,GHSA-4w7w-66w2-5vf9,GHSA-4x5r-pxfx-6jf8,GHSA-52cp-r559-cp3m,GHSA-5c6j-r48x-rmvq,GHSA-5p4m-2wfm-xmqj,GHSA-6g55-p6wh-862q,GHSA-737v-mqg7-c878,GHSA-7h2j-956f-4vf2,GHSA-7p8r-x3mc-p8w7,GHSA-7r86-cg39-jmmj,GHSA-c2c7-rcm5-vvqj,GHSA-f23m-r3pf-42rh,GHSA-f886-m6hf-6m8v,GHSA-f88m-g3jw-g9cj,GHSA-fv7c-fp4j-7gwp,GHSA-fx2h-pf6j-xcff,GHSA-fxqj-rqcc-2cmp,GHSA-h67p-54hq-rp68,GHSA-mh29-5h37-fv8m,GHSA-mh99-v99m-4gvg,GHSA-mw96-cpmx-2vgc,GHSA-p9ff-h696-f583,GHSA-q3j6-qgpj-74h6,GHSA-qj8w-gfj5-8c6v,GHSA-qx2v-qp2m-jg93,GHSA-r28c-9q8g-f849,GHSA-r5fr-rjxr-66jc,GHSA-rf6f-7fwh-wjgh,GHSA-rgw5-rvv9-x895,GHSA-v2hh-gcrm-f6hx,GHSA-v2wj-q39q-566r,GHSA-v39h-62p7-jpjc,GHSA-v6h2-p8h4-qcjw,GHSA-v6wh-96g9-6wx3,GHSA-xxjr-mmjv-4gpg
