################################################################################################################
### DSMR-reader configuration.                                                                              ###
###                                                                                                          ###
### This file belongs to the administrator: the package creates it on first install and never overwrites    ###
### it afterwards.                                                                                           ###
###                                                                                                          ###
### For a full list of environment vars to use (or override) see:                                            ###
### https://dsmr-reader.readthedocs.io/en/latest/env_settings.html                                           ###
###                                                                                                          ###
### DJANGO_SECRET_KEY is appended by postinst when it is missing.                                            ###
################################################################################################################

### Database. sqlite is the packaged default but is not supported upstream
### (DSMR-reader only supports postgresql/mysql; sqlite full backups work,
### partial backups do not).
DJANGO_DATABASE_ENGINE=django.db.backends.sqlite3
#DJANGO_DATABASE_HOST=localhost
#DJANGO_DATABASE_PORT=5432
DJANGO_DATABASE_NAME=/var/lib/dsmrreader/db.sqlite
#DJANGO_DATABASE_USER=dsmrreader
#DJANGO_DATABASE_PASSWORD=dsmrreader

### Admin credentials. Required since v6.0.0: without them "manage.py
### dsmr_superuser" (run by postinst) fails and the webinterface has no login.
DSMRREADER_ADMIN_USER=admin
DSMRREADER_ADMIN_PASSWORD=admin

### Logging level.
###DSMRREADER_LOGLEVEL=DEBUG
