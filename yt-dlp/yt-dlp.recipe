[INFO]
arch=amd64

[VERSION]
B_GITVER https://github.com/yt-dlp/yt-dlp

[REQUIRED]
make zip pandoc

[BUILD]
B_GET git https://github.com/yt-dlp/yt-dlp yt-dlp
cd yt-dlp
git checkout ${B_VERSION}
make
# The build system exports DESTDIR into the build environment, and yt-dlp's
# Makefile install target uses $(DESTDIR)$(PREFIX). Pass both explicitly so
# files land in B_INSTALLDIR instead of a doubled path (empty package).
make DESTDIR=$B_INSTALLDIR PREFIX=/usr install

[SECURITY]
# SRCGUARD false positive: pyproject.toml lists the optional dependency
# curl-cffi (a Python package name), which the heuristic matches as
# 'curl' network access in a build script. No actual network access.
srcguard-ignore=yt-dlp/pyproject.toml

[PKG]
type=deb
torepo=y

[DEB]
Package: yt-dlp
Version: B_VERSION
Section: yt-dlp
Priority: optional
Architecture: B_ARCH
Maintainer: B_MAIL
Description: yt-dlp custom B_ORG build
Homepage: https://github.com/yt-dlp/yt-dlp
