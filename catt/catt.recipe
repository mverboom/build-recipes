[VERSION]
B_GITVER https://github.com/skorokithakis/catt

[INFO]
arch=amd64

[REQUIRED]
python3 python3-pip python3-certifi python3-chardet

[BUILD]
B_GET git https://github.com/skorokithakis/catt catt
cd catt
git checkout v$B_VERSION
pip3 install --prefix=$B_INSTALLDIR/opt/catt catt==$B_VERSION

[PKG]
type=deb
torepo=y

[DEB]
Package: catt
Version: B_VERSION
Section: catt
Priority: optional
Architecture: B_ARCH
Maintainer: B_MAIL
Description: catt custom B_ORG build
Homepage: https://github.com/skorokithakis/catt
Depends: python3, python3-protobuf, python3-certifi, python3-chardet

[SECURITY]
# Findings from security-scan of cached sources; suppressed so
# vulnscan=enforce / srcguard=enforce builds pass. Review periodically;
# new findings still fail the build until reviewed.
vulnscan-ignore=GHSA-5239-wwwm-4pmq,GHSA-mrwq-x4v8-fh7p,GHSA-qmgc-5h2g-mvrw,GHSA-w853-jp5j-5j7f,PYSEC-2023-117,PYSEC-2026-1374,PYSEC-2026-1375,PYSEC-2026-2987
