[VERSION]
B_GITVER -i "^3.8" -D -e a[0-9]\*\$ https://github.com/python/cpython

[INFO]
arch=amd64

[REQUIRED]
gcc make libssl-dev libbz2-dev libncurses5-dev zlib1g-dev libsqlite3-dev libreadline-dev liblzma-dev uuid-dev libgdbm-dev tcl-dev tk-dev libffi-dev

[BUILD DEBIAN BUSTER]
B_GET git https://github.com/python/cpython python
cd python
git checkout v$B_VERSION
./configure --prefix=/opt/python
make -j $(nproc)
make DESTDIR=$B_INSTALLDIR install

[PKG]
type=deb
torepo=y

[DEB]
Package: python-3.8
Version: B_VERSION
Section: python-3.8
Priority: optional
Architecture: B_ARCH
Maintainer: B_MAIL
Description: Python-3.8 custom B_ORG build
Homepage: https://github.com/python/cpython

[SECURITY]
# Findings from security-scan of cached sources; suppressed so
# vulnscan=enforce / srcguard=enforce builds pass. Review periodically;
# new findings still fail the build until reviewed.
vulnscan-ignore=GHSA-65pc-fj4g-8rjx,GHSA-q8mj-m7cp-5q26,GHSA-r4q5-vmmm-2653,PYSEC-2026-215
srcguard-ignore=python/Makefile.pre.in
