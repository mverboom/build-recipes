[INFO]
arch=amd64

[VERSION]
B_GITVER https://github.com/apache/guacamole-server

[REQUIRED]
autoconf automake libtool pkg-config make libpng-dev libjpeg-dev libcairo2-dev uuid-dev libossp-uuid-dev gcc libssl-dev libssh2-1-dev libwebp-dev libpulse-dev libvncserver-dev libtelnet-dev freerdp2-B_PF libpango1.0-dev libavutil-dev libswscale-dev libvorbis-dev

[BUILD]
B_GET git https://github.com/apache/guacamole-server guacamole-server
cd guacamole-server
git checkout ${B_VERSION}

# freerdp2 is installed under /opt/freerdp2 by the custom LNW package.
# Make sure pkg-config, the compiler and the linker can find it.
export PKG_CONFIG_PATH=/opt/freerdp2/lib/pkgconfig:/usr/lib/x86_64-linux-gnu/pkgconfig
export CPPFLAGS="-I/opt/freerdp2/include/freerdp2 -I/opt/freerdp2/include/winpr2"
export LIBRARY_PATH=/opt/freerdp2/lib:$LIBRARY_PATH
export LD_LIBRARY_PATH=/opt/freerdp2/lib:$LD_LIBRARY_PATH

autoreconf -fi
./configure --prefix=/opt/guacamole --with-systemd-dir=/lib/systemd/system --with-ssh --with-rdp --with-vnc --with-terminal --with-telnet --with-webp --enable-allow-freerdp-snapshots
make -j $(nproc)
make install DESTDIR=$B_INSTALLDIR
mkdir -p $B_INSTALLDIR/var/lib/guacamole
B_GET http "http://apache.org/dyn/closer.cgi?action=download&filename=guacamole/${B_VERSION}/binary/guacamole-${B_VERSION}.war" guacamole.war
mv guacamole.war $B_INSTALLDIR/var/lib/guacamole/guacamole.war

[PKG]
type=deb
torepo=y

[DEB]
Package: guacamole-server
Version: B_VERSION
Section: guacamole
Priority: optional
Architecture: B_ARCH
Maintainer: B_MAIL
Description: Guacamole server custom B_ORG build
Homepage: https://guacamole.apache.org/
Depends: libpng16-16t64,libpango-1.0-0,libtelnet2,libssh2-1t64,libwebp7,libvncclient1,libpulse0,libcairo2,freerdp2-B_PF

[SECURITY]
# Findings from security-scan of cached sources; suppressed so
# vulnscan=enforce / srcguard=enforce builds pass. Review periodically;
# new findings still fail the build until reviewed.
vulnscan-ignore=GHSA-25qh-j22f-pwp8,GHSA-344f-f5vg-2jfj,GHSA-3pjw-73gf-8qr5,GHSA-3vx3-xf6q-r5xp,GHSA-475f-74wp-pqv5,GHSA-563x-q5rq-57qp,GHSA-5jmj-h7xm-6q6v,GHSA-5m62-pw8w-7w9f,GHSA-5mp6-jrq3-r938,GHSA-72hv-8253-57qq,GHSA-8qq4-8jvq-mfw4,GHSA-9m89-8frq-c98c,GHSA-cj7v-27pg-wf7q,GHSA-cw54-59pw-4g8c,GHSA-fpj8-gq4v-p354,GHSA-fv25-8xcx-gqjc,GHSA-gx5v-xp9w-j4cg,GHSA-h6fc-48rj-7qqh,GHSA-hgj6-7826-r7m5,GHSA-j3rv-43j4-c7qm,GHSA-jc7p-5r39-9477,GHSA-jhq6-gfmj-v8fx,GHSA-jjpq-gp5q-8q6w,GHSA-p47f-322f-whfh,GHSA-prc3-7f44-w48j,GHSA-qh8g-58pp-2wxh,GHSA-qprx-q2r7-3rx6,GHSA-qq5r-98hh-rxc9,GHSA-qqpg-mvqg-649v,GHSA-r29c-68gh-xp6x,GHSA-r7wm-3cxj-wff9,GHSA-rmj7-2vxq-3g9f,GHSA-v646-rx6w-r3qq,GHSA-w3j5-q8f2-3cqq,GHSA-xcpr-7mr4-h4xq,GHSA-xh5x-j8jf-pcpx,GHSA-xjgh-84hx-56c5
