[INFO]
arch=amd64

[REQUIRED]
maven default-jdk

[VERSION]
B_GITVER https://github.com/apache/guacamole-client

[BUILD]
B_GET git https://github.com/apache/guacamole-client guacamole-client
cd guacamole-client
#git checkout ${B_VERSION}
export JAVA_HOME=/usr/lib/jvm/default-java
# Ignore license errors
sed -i 's#<ignoreLicenseErrors>false</ignoreLicenseErrors>#<ignoreLicenseErrors>true</ignoreLicenseErrors>#' pom.xml
# 20190718 MV: skip javadoc due to errors
mvn package -Dmaven.javadoc.skip=true -DskipTests=true
mkdir -p $B_INSTALLDIR/var/lib/guacamole/
mv target/guacamole-client-*.tar.gz $B_INSTALLDIR/var/lib/guacamole/

[PKG]
type=deb
torepo=y

[DEB]
Package: guacamole-client
Version: B_VERSION
Section: guacamole
Priority: optional
Architecture: B_ARCH
Maintainer: B_MAIL
Description: Guacamole client custom B_ORG build
Homepage: https://guacamole.apache.org/

[SECURITY]
# Findings from security-scan of cached sources; suppressed so
# vulnscan=enforce / srcguard=enforce builds pass. Review periodically;
# new findings still fail the build until reviewed.
vulnscan-ignore=GHSA-28wg-ghj8-5hjv,GHSA-2m8v-j782-fhvr,GHSA-2p49-hgcm-8545,GHSA-2qqx-w9hr-q5gx,GHSA-2v37-7h3g-55p8,GHSA-2vrf-hf26-jrp5,GHSA-344f-f5vg-2jfj,GHSA-3vx3-xf6q-r5xp,GHSA-475f-74wp-pqv5,GHSA-4w4v-5hc9-xrr2,GHSA-563x-q5rq-57qp,GHSA-5c6j-r48x-rmvq,GHSA-5m62-pw8w-7w9f,GHSA-5mp6-jrq3-r938,GHSA-7p8r-x3mc-p8w7,GHSA-7x27-g8rg-x87w,GHSA-8qq4-8jvq-mfw4,GHSA-9m89-8frq-c98c,GHSA-cw54-59pw-4g8c,GHSA-fpj8-gq4v-p354,GHSA-fv25-8xcx-gqjc,GHSA-fxqj-rqcc-2cmp,GHSA-gx5v-xp9w-j4cg,GHSA-h6fc-48rj-7qqh,GHSA-j288-q9x7-2f5v,GHSA-j58c-ww9w-pwp5,GHSA-jc7p-5r39-9477,GHSA-jjpq-gp5q-8q6w,GHSA-m2h2-264f-f486,GHSA-m9gf-397r-hwpg,GHSA-mh99-v99m-4gvg,GHSA-mqm9-c95h-x2p6,GHSA-pfq8-rq6v-vf5m,GHSA-prc3-7f44-w48j,GHSA-prc3-vjfx-vhm9,GHSA-qj8w-gfj5-8c6v,GHSA-qprx-q2r7-3rx6,GHSA-qq5r-98hh-rxc9,GHSA-qwqh-hm9m-p5hr,GHSA-r28c-9q8g-f849,GHSA-r29c-68gh-xp6x,GHSA-rgw5-rvv9-x895,GHSA-v2hh-gcrm-f6hx,GHSA-v646-rx6w-r3qq,GHSA-xcpr-7mr4-h4xq,GHSA-xfqm-j7pc-xrfc,GHSA-xjgh-84hx-56c5,MAL-2025-21003
