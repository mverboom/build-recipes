[INFO]
arch=amd64
# Version tag in the repo is not v$B_VERSION/$B_VERSION; shallow refresh must fetch the exact tag for checkout.
gittag=libssh-$B_VERSION

[VERSION]
B_GITVER -F libssh- https://github.com/libssh/libssh-mirror/

[REQUIRED]
cmake gcc zlib1g-dev libssl-dev g++

[BUILD]
B_GET git https://github.com/libssh/libssh-mirror libssh
cd libssh
git checkout libssh-$B_VERSION
mkdir build
cd build
cmake -DCMAKE_INSTALL_PREFIX:PATH=/opt/libssh ..
make -j $(nproc)
make install DESTDIR=$B_INSTALLDIR

[PKG]
type=deb
torepo=y

[DEB]
Package: libssh
Version: B_VERSION
Section: libssh
Priority: optional
Architecture: B_ARCH
Maintainer: B_MAIL
Description: Libssh custom B_ORG build
Homepage: https://www.libssh.org
