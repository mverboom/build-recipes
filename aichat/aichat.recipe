[INFO]
arch=amd64

[VERSION]
B_GITVER https://github.com/sigoden/aichat

[REQUIRED]
rustc-B_PF gcc

[BUILD]
B_GET git https://github.com/sigoden/aichat aichat
cd aichat
git checkout v${B_VERSION}
cargo build --release
mkdir -p $B_INSTALLDIR/usr/bin
cp target/release/aichat $B_INSTALLDIR/usr/bin

[PKG]
type=deb
torepo=y

[DEB]
Package: aichat
Version: B_VERSION
Section: aichat
Priority: optional
Architecture: B_ARCH
Maintainer: B_MAIL
Description: Aichat server custom B_ORG build
Homepage: https://github.com/sigoden/aichat

[SECURITY]
# Findings from security-scan of cached sources; suppressed so
# vulnscan=enforce / srcguard=enforce builds pass. Review periodically;
# new findings still fail the build until reviewed.
vulnscan-ignore=GHSA-434x-w66g-qw3r,GHSA-4w2j-m93h-cj5j,GHSA-6xvm-j4wr-6v98,GHSA-82j2-j2ch-gfr8,GHSA-965h-392x-2mh5,GHSA-cq8v-f236-94qc,GHSA-pwjx-qhcg-rvj4,GHSA-qx2v-8332-m4fv,GHSA-r6v5-fh4h-64xc,GHSA-xgp8-3hg3-c2mh,GHSA-xwfj-jgwm-7wp5,RUSTSEC-2025-0047,RUSTSEC-2025-0055,RUSTSEC-2025-0057,RUSTSEC-2025-0141,RUSTSEC-2026-0007,RUSTSEC-2026-0009,RUSTSEC-2026-0037,RUSTSEC-2026-0049,RUSTSEC-2026-0097,RUSTSEC-2026-0098,RUSTSEC-2026-0099,RUSTSEC-2026-0104,RUSTSEC-2026-0185,RUSTSEC-2026-0190,RUSTSEC-2026-0194,RUSTSEC-2026-0195,RUSTSEC-2026-0204,RUSTSEC-2026-0258
