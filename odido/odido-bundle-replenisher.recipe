[INFO]
arch=amd64

[VERSION]
B_GITVER https://github.com/lodu/odido-bundle-replenisher

[REQUIRED]
rustc-B_PF gcc g++ cmake perl make

[BUILD]
B_GET git https://github.com/lodu/odido-bundle-replenisher odido-bundle-replenisher
cd odido-bundle-replenisher
git checkout v${B_VERSION}
cargo build --release --locked
mkdir -p $B_INSTALLDIR/opt/odido-bundle-replenisher
cp target/release/odido-bundle-replenisher $B_INSTALLDIR/opt/odido-bundle-replenisher/
ln -s /etc/odido-bundle-replenisher.cfg $B_INSTALLDIR/opt/odido-bundle-replenisher/.env
B_LINKFILE /opt/odido-bundle-replenisher/odido-bundle-replenisher /usr/bin

[PKG]
type=deb
torepo=y

[DEB]
Package: odido-bundle-replenisher
Version: B_VERSION
Section: odido-bundle-replenisher
Priority: optional
Architecture: B_ARCH
Maintainer: B_MAIL
Description: odido-bundle-replenisher custom B_ORG build
Homepage: https://github.com/lodu/odido-bundle-replenisher
Depends: libgcc-s1, ca-certificates
