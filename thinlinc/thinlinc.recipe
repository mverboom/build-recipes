[INFO]
arch=amd64,i386,armhf

[VERSION]
wget -q -O - https://www.cendio.com/thinlinc/download | grep "thinlinc-client" | grep ${B_ARCH}.deb | sed 's#.*/thinlinc-client_##;s#_.*##' | head -n 1

[BUILD]
echo https://www.cendio.com/downloads/clients/thinlinc-client_${B_VERSION}_${B_ARCH}.deb
B_GET http https://www.cendio.com/downloads/clients/thinlinc-client_${B_VERSION}_${B_ARCH}.deb thinlinc-client_${B_VERSION}_${B_ARCH}.deb
DEBNAME=thinlinc-client_${B_VERSION}_${B_ARCH}.deb
dpkg-deb -x "$DEBNAME" tmpdir
dpkg-deb --control "$DEBNAME"
# Re-version the package with the distro suffix (e.g. 4.21.0-4588-lnw+deb13)
# like the other recipes, so packages built for different Debian releases
# (and rebuilds) never collide on the repository server.
DEBDIST=$(lsb_release -r -s | cut -d'.' -f 1)
NEWVER="${B_VERSION}-${PKGPOSTFIX}+deb${DEBDIST}"
sed -i "s/^Version:.*/Version: ${NEWVER}/" DEBIAN/control
mv DEBIAN tmpdir/
NEWDEBNAME="thinlinc-client_${NEWVER}_${B_ARCH}.deb"
dpkg-deb -b tmpdir "$NEWDEBNAME"
mv "$NEWDEBNAME" ${B_INSTALLDIR}

[PKG]
type=deb
pkgready=y
torepo=y
