# Storage location
DATA_DIR=/var/lib/open-webui
# WEBUI_SECRET_KEY is generated per installation in /etc/openwebui/secret (see
# the postinst), so that no secret ships in the package and every instance has
# its own. A value set here still takes precedence over the generated one.
# Use proxy for internet access
#http_proxy=http://proxy:8080
#https_proxy=http://proxy:8080
# Slim install (see the recipe): no local RAG/embedding/audio/image stack, so
# the app must not try to load torch/chromadb/transformers at runtime.
USE_SLIM_DOCKER=true
