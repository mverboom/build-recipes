[VERSION]
B_GITVER https://github.com/pytoyoda/pytoyoda/

[INFO]
arch=amd64

[REQUIRED]
python3-pip python3-dateutil  python3-arrow python3-marisa python3-jwt python3-loguru python3-annotated-types python3-certifi
#python3-pip python3-httpx python3-pydantic python3-dateutil python3-importlib-metadata python3-hishel python3-arrow python3-marisa python3-jwt python3-loguru

[BUILD]
B_GET git https://github.com/pytoyoda/pytoyoda/ pytoyoda
cd pytoyoda
git checkout v${B_VERSION}
pip3 install --root=$B_INSTALLDIR .
cd $B_INSTALLDIR
mkdir -p "usr/lib/python3"
pushd "usr/local/lib/python3.13"
mv dist-packages "$B_INSTALLDIR/usr/lib/python3"
popd
rm -rf usr/local

[PKG]
type=deb
torepo=y

[DEB]
Package: python3-pytoyoda
Version: B_VERSION
Section: python3
Priority: optional
Architecture: B_ARCH
Maintainer: B_MAIL
Description: Python3 pytoyoda bindings custom B_ORG build
Homepage: https://github.com/pytoyoda/pytoyoda/
Depends: python3,python3-loguru,python3-dateutil,python3-arrow,python3-marisa,python3-jwt,python3-annotated-types
#Depends: python3,python3-loguru,python3-httpx,python3-pydantic,python3-dateutil,python3-importlib-metadata,python3-hishel,python3-arrow,python3-marisa,python3-jwt

[SECURITY]
# Findings from security-scan of cached sources; suppressed so
# vulnscan=enforce / srcguard=enforce builds pass. Review periodically;
# new findings still fail the build until reviewed.
vulnscan-ignore=GHSA-5239-wwwm-4pmq,GHSA-65pc-fj4g-8rjx,GHSA-6v7p-g79w-8964,GHSA-993g-76c3-p5m4,GHSA-fhv5-28vv-h8m8,GHSA-jq35-7prp-9v3f,GHSA-w7vc-732c-9m39,GHSA-xgmm-8j9v-c9wx,PYSEC-2026-175,PYSEC-2026-177,PYSEC-2026-178,PYSEC-2026-179,PYSEC-2026-215,PYSEC-2026-2987,PYSEC-2026-3625
