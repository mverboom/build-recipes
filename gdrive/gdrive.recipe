[INFO]
arch=amd64
excludefromall=1

[VERSION]
B_GITVER https://github.com/prasmussen/gdrive

[REQUIRED]
golang-B_PF

[BUILD]
export PATH=${PATH}:${GOROOT}/bin
export GOPATH=$(pwd)

go install github.com/prasmussen/gdrive@$B_VERSION
mkdir -p $B_INSTALLDIR/usr/bin
cp bin/gdrive $B_INSTALLDIR/usr/bin

[PKG]
type=deb
torepo=y

[DEB]
Package: gdrive
Version: B_VERSION
Section: gdrive
Priority: optional
Architecture: B_ARCH
Maintainer: B_MAIL
Homepage: https://github.com/prasmussen/gdrive
Description: Gdrive custom B_ORG build

[SECURITY]
# Findings from security-scan of cached sources; suppressed so
# vulnscan=enforce / srcguard=enforce builds pass. Review periodically;
# new findings still fail the build until reviewed.
vulnscan-ignore=GHSA-2wrh-6pvc-2jm9,GHSA-39qc-96h7-956f,GHSA-3vm4-22fp-5rfm,GHSA-4374-p667-p6c8,GHSA-449p-3h89-pw88,GHSA-45gg-vh54-h5m9,GHSA-45x7-px36-x8w8,GHSA-4r78-hx75-jjj2,GHSA-4v7x-pqxf-cx7m,GHSA-5cgq-3rg8-m6cv,GHSA-5cv4-jp36-h3mw,GHSA-5rcv-m4m3-hfh7,GHSA-69cg-p879-7622,GHSA-69ch-w2m2-3vjp,GHSA-6v2p-p543-phr9,GHSA-6wxm-mpqj-6jpf,GHSA-78mq-xcr3-xm33,GHSA-83g2-8m93-v3w7,GHSA-89gr-r52h-f8rx,GHSA-8c26-wmh5-6g9v,GHSA-9m57-25v3-79x9,GHSA-cjjc-xp8v-855w,GHSA-f5wc-c3c7-36mc,GHSA-f6x5-jh6r-wrfv,GHSA-ffhg-7mh4-33c4,GHSA-gwc9-m7rh-j2ww,GHSA-h86h-8ppg-mxmh,GHSA-hcg3-q754-cr77,GHSA-hgr8-6h9x-f7q9,GHSA-hrxh-6v49-42gf,GHSA-j5w8-q4qc-rx2x,GHSA-jppx-rxg9-jmrx,GHSA-m425-mq94-257g,GHSA-mv93-wvcp-7m7r,GHSA-mw99-9chc-xw7r,GHSA-p77j-4mvh-x3m3,GHSA-p782-xgp4-8hr8,GHSA-ppp9-7jff-5vj2,GHSA-q4h4-gmj2-qvw2,GHSA-qppj-fm5r-hxr3,GHSA-qpw4-5x99-6vjp,GHSA-qxp5-gwg8-xv66,GHSA-r5c5-pr8j-pfp7,GHSA-r9px-m959-cxf4,GHSA-rm3j-f69w-wqmq,GHSA-v725-9546-7q7m,GHSA-v778-237x-gjrc,GHSA-vfw5-hrgq-h5wf,GHSA-vgwf-h737-ff37,GHSA-vvgc-356p-c3xw,GHSA-vvpx-j8f3-3w6h,GHSA-w879-237q-wc7r,GHSA-wxc4-f4m6-wwqv,GHSA-x3jr-pf6g-c48f,GHSA-x527-x647-q7gg,GHSA-xrjj-mj9h-534m,GO-2020-0012,GO-2020-0014,GO-2020-0015,GO-2020-0036,GO-2021-0113,GO-2021-0227,GO-2021-0238,GO-2021-0356,GO-2022-0197,GO-2022-0209,GO-2022-0229,GO-2022-0236,GO-2022-0288,GO-2022-0493,GO-2022-0536,GO-2022-0968,GO-2022-0969,GO-2022-1059,GO-2022-1144,GO-2023-1571,GO-2023-1988,GO-2023-1992,GO-2023-2102,GO-2023-2153,GO-2023-2402,GO-2024-2456,GO-2024-2466,GO-2024-2687,GO-2024-2961,GO-2024-3321,GO-2024-3333,GO-2025-3367,GO-2025-3368,GO-2025-3372,GO-2025-3487,GO-2025-3488,GO-2025-3503,GO-2025-3595,GO-2025-4116,GO-2025-4134,GO-2025-4135,GO-2026-4440,GO-2026-4441,GO-2026-4762,GO-2026-4918,GO-2026-5005,GO-2026-5006,GO-2026-5013,GO-2026-5014,GO-2026-5015,GO-2026-5016,GO-2026-5017,GO-2026-5018,GO-2026-5019,GO-2026-5020,GO-2026-5021,GO-2026-5023,GO-2026-5024,GO-2026-5025,GO-2026-5026,GO-2026-5027,GO-2026-5028,GO-2026-5029,GO-2026-5030,GO-2026-5033,GO-2026-5932,GO-202