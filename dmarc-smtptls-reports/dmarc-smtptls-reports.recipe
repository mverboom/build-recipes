[INFO]
arch=all

[VERSION]
B_GITVER https://github.com/antedebaas/DMARC-SMTPTLS-Reports

[REQUIRED]
php-cli composer php-curl php-imap php-xml php-sqlite3

[BUILD]
B_GET git https://github.com/antedebaas/DMARC-SMTPTLS-Reports dmarc-smtptls-reports
cd dmarc-smtptls-reports
git checkout v${B_VERSION}

sed -i 's#DATABASE_URL=.*#DATABASE_URL="sqlite:////var/lib/dmarc-smtptls-reports/database.sqlite"#' .env

composer update
composer install
php bin/console cache:clear
#php bin/console doctrine:migrations:migrate --no-interaction --query-time
php bin/console assets:install public
php bin/console cache:warmup

mkdir -p $B_INSTALLDIR/var/lib/dmarc-smtptls-reports/imap
mkdir -p $B_INSTALLDIR/var/log/dmarc-smtptls-reports
rmdir var/log
ln -s /var/log/dmarc-smtptls-reports var/log
ln -s /var/lib/dmarc-smtptls-reports/imap var/imap

ln -s /etc/dmarc-smtptls-reports/config .env.local

mkdir -p $B_INSTALLDIR/opt/dmarc-smtptls-reports
rm -rf .git .github
rm -f .env.test
tar cf - . | (cd $B_INSTALLDIR/opt/dmarc-smtptls-reports ; tar xf - )

[PKG]
type=deb
torepo=y

[DEB]
Package: dmarc-smtptls-reports
Version: B_VERSION
Section: dmarc-smtptls-reports
Priority: optional
Architecture: B_ARCH
Maintainer: B_MAIL
Description: dmarc-smtptls-reports custom B_ORG build
Homepage: https://github.com/antedebaas/DMARC-SMTPTLS-Reports
Depends: php-cli, php-curl, php-imap, php-xml, php-sqlite3
[SECURITY]
# Findings from security-scan of cached sources; suppressed so
# vulnscan=enforce / srcguard=enforce builds pass. Review periodically;
# new findings still fail the build until reviewed.
vulnscan-ignore=GHSA-24x9-r6q4-q93w,GHSA-2g2g-8p8h-fgwm,GHSA-2q52-x2ff-qgfr,GHSA-2xf4-cg6j-vhgq,GHSA-38cx-cq6f-5755,GHSA-3rg7-wf37-54rm,GHSA-45vw-wh46-2vx8,GHSA-4j38-f5cw-54h7,GHSA-4qpc-3hr4-r2p4,GHSA-529h-vh3j-85hq,GHSA-5v5v-ww74-355v,GHSA-6h46-9jf5-q59x,GHSA-6qh9-h6wf-jgqc,GHSA-72xp-p242-47p9,GHSA-7fxw-r6jv-74c8,GHSA-7p85-w9px-jpjp,GHSA-8x9c-rmqh-456c,GHSA-9frc-8383-795m,GHSA-c2p3-7m5p-cv8x,GHSA-fqc7-9xjw-jrh3,GHSA-h5x3-xfc9-m39h,GHSA-h8vq-8gpg-mhcg,GHSA-j8gj-9rm5-4xhx,GHSA-p42q-9prx-q5wq,GHSA-ph86-p8f6-f9r2,GHSA-pr2w-4gpj-cpq4,GHSA-qpmx-3rfj-7rhv,GHSA-vcc8-phrv-43wj,GHSA-vqc8-7275-q272,GHSA-vvj3-c3rp-c85p,GHSA-x6g4-fwcc-jj8w,GHSA-xx3c-qf5g-hc39
