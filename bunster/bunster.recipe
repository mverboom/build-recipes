[INFO]
arch=amd64

[VERSION]
B_GITVER https://github.com/yassinebenaid/bunster

[REQUIRED]
golang-B_PF make

[BUILD]
export GOROOT=/opt/go
export PATH=${PATH}:${GOROOT}/bin
B_GET git https://github.com/yassinebenaid/bunster bunster
cd bunster
git checkout v$B_VERSION
export GOPATH=$(pwd)
make build
mkdir -p "$B_INSTALLDIR/usr/bin"
cp bin/bunster "$B_INSTALLDIR/usr/bin"

[PKG]
type=deb
torepo=y

[DEB]
Package: bunster
Version: B_VERSION
Section: bunster
Priority: optional
Architecture: B_ARCH
Maintainer: B_MAIL
Homepage: https://github.com/yassinebenaid/bunster
Description: bunster B_PF custom build
Depends: golang-B_PF

[SECURITY]
# Findings from security-scan of cached sources; suppressed so
# vulnscan=enforce / srcguard=enforce builds pass. Review periodically;
# new findings still fail the build until reviewed.
vulnscan-ignore=GHSA-28wg-ghj8-5hjv,GHSA-2v37-7h3g-55p8,GHSA-356w-63v5-8wf4,GHSA-4fh9-h7wg-q85m,GHSA-4r4m-qw57-chr8,GHSA-4w7w-66w2-5vf9,GHSA-67mh-4wv8-2f99,GHSA-6g55-p6wh-862q,GHSA-859w-5945-r5v3,GHSA-93m4-6634-74q7,GHSA-fx2h-pf6j-xcff,GHSA-fxqj-rqcc-2cmp,GHSA-g4jq-h2w9-997c,GHSA-jqfw-vq24-v9c3,GHSA-mw96-cpmx-2vgc,GHSA-qx2v-qp2m-jg93,GHSA-r28c-9q8g-f849,GHSA-v6wh-96g9-6wx3,GHSA-x574-m823-4x7w,GHSA-xcj6-pq6g-qj4x,GO-2026-5024
