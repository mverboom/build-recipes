[INFO]
arch=amd64

[VERSION]
wget -q -O - https://nodejs.org/en/download/ | sed 's/>v/>\nv/g' | sed -n 's/^v\([0-9.]\+\)<\/span><span[^>]*>LTS.*/\1/p' | sort -u | tail -1

[REQUIRED]
python3 make gcc g++

[REQUIRED DEBIAN TRIXIE]
python3 make gcc g++

[BUILD]
B_GET git https://github.com/nodejs/node/ nodejs
cd nodejs
git checkout v$B_VERSION
test "$B_ARCH" = "armhf" && export CXXFLAGS="-march=armv6k -mfpu=vfpv2"
./configure --prefix=/opt/nodejs
make -j 2
make install DESTDIR=$B_INSTALLDIR
B_LINKFILES /opt/nodejs/bin /usr/bin

[PKG]
type=deb
torepo=y

[DEB]
Package: nodejs-lts
Version: B_VERSION
Section: nodejs-lts
Priority: optional
Architecture: B_ARCH
Maintainer: B_MAIL
Description: Nodejs LTS custom B_ORG build
Provides: nodejs-runtime
Conflicts: nodejs, nodejs-runtime

[SECURITY]
# Findings from security-scan of cached sources; suppressed so
# vulnscan=enforce / srcguard=enforce builds pass. Review periodically;
# new findings still fail the build until reviewed.
srcguard-ignore=nodejs/deps/cares/Makefile.dj,nodejs/deps/cares/Makefile.netware,nodejs/deps/undici/src/package.json
