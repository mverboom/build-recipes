[INFO]
arch=amd64

[VERSION]
B_GITVER https://github.com/datproject/dat

[REQUIRED]
nodejs-B_PF

[BUILD]
B_GET git https://github.com/datproject/dat dat
cd dat
git checkout tags/v$B_VERSION
export npm_config_prefix=$B_INSTALLDIR/opt/dat
npm install -g dat
B_LINKFILES /opt/dat/bin /usr/bin

[PKG]
type=deb
torepo=y

[DEB]
Package: dat
Version: B_VERSION
Section: dat
Priority: optional
Architecture: B_ARCH
Maintainer: B_MAIL
Description: Dat custom B_ORG build
Homepage: https://datproject.org
Depends: nodejs-B_PF

[SECURITY]
# Findings from security-scan of cached sources; suppressed so
# vulnscan=enforce / srcguard=enforce builds pass. Review periodically;
# new findings still fail the build until reviewed.
vulnscan-ignore=GHSA-22r3-9w55-cj54,GHSA-23c5-xmqv-rm74,GHSA-29mw-wpgm-hmr9,GHSA-2g4f-4pwh-qvx6,GHSA-2p57-rm9w-gvfp,GHSA-35jh-r3h4-6jhm,GHSA-395f-4hp3-45gv,GHSA-3jxr-9vmj-r5cp,GHSA-3ppc-4f35-3m26,GHSA-3v7f-55p6-f55p,GHSA-3wcq-x3mq-6r9p,GHSA-3xgq-45jj-v275,GHSA-43f8-2h32-f4cj,GHSA-52cp-r559-cp3m,GHSA-52f5-9888-hmc6,GHSA-5p4m-2wfm-xmqj,GHSA-6rw7-vpxm-498p,GHSA-72xf-g2v4-qvf3,GHSA-78xj-cgh5-2h22,GHSA-7r86-cg39-jmmj,GHSA-896r-f27r-55mw,GHSA-93q8-gq69-wqmw,GHSA-952p-6rrq-rcjv,GHSA-968p-4wvh-cqc8,GHSA-c2c7-rcm5-vvqj,GHSA-c2qf-rxjj-qqgw,GHSA-f23m-r3pf-42rh,GHSA-f886-m6hf-6m8v,GHSA-f8q6-p94x-37v3,GHSA-ff7x-qrg7-qggm,GHSA-fjxv-7rqg-78g4,GHSA-g4rg-993r-mgx7,GHSA-grv7-fg5c-xmjg,GHSA-gxpj-cx7g-858c,GHSA-h67p-54hq-rp68,GHSA-hj48-42vr-x3v9,GHSA-hmw2-7cc7-3qxx,GHSA-hrpp-h998-j3pp,GHSA-j8xg-fqg3-53r7,GHSA-mh29-5h37-fv8m,GHSA-mh99-v99m-4gvg,GHSA-p6mc-m468-83gw,GHSA-p8p7-x288-28g6,GHSA-pfrx-2q88-qq97,GHSA-ph9p-34f9-6g65,GHSA-qqgx-2p2h-9c37,GHSA-r5fr-rjxr-66jc,GHSA-r683-j2x4-v87g,GHSA-rgw5-rvv9-x895,GHSA-rx8g-88g5-qh64,GHSA-v6h2-p8h4-qcjw,GHSA-v88g-cgmw-v5xw,GHSA-w573-4hg7-7wgq,GHSA-w5hq-g745-h8pq,GHSA-w7jw-789q-3m8p,GHSA-wpg7-2c88-r8xv,GHSA-ww39-953v-wcq6,GHSA-x55w-vjjp-222r,GHSA-xvch-5gv4-984h,GHSA-xxjr-mmjv-4gpg
