[INFO]
arch=amd64

[SECURITY]
# image-size@2.0.2 in etc/imageResize (build-time tool, not shipped/used) has
# 2 HIGH DoS advisories. No fixed version exists (npm latest is still 2.0.2,
# repo archived). Suppress the two known IDs; enforce stays active for any
# other finding.
vulnscan=enforce
vulnscan-ignore=GHSA-5p2g-fcmc-qvqq,GHSA-w3rx-r6r6-pgpr

[VERSION]
B_GITVER https://github.com/jgraph/drawio

[BUILD]
rm -rf drawio
git clone --depth 1 --branch "v$B_VERSION" https://github.com/jgraph/drawio drawio
cd drawio/src/main
mkdir -p $B_INSTALLDIR/opt/drawio/
mv webapp $B_INSTALLDIR/opt/drawio/

[PKG]
type=deb
torepo=y

[DEB]
Package: drawio
Version: B_VERSION
Section: drawio
Priority: optional
Architecture: B_ARCH
Maintainer: B_MAIL
Description: DrawIO custom B_ORG build
Homepage: https://www.diagrams.net/
