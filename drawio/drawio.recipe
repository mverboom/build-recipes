[INFO]
arch=amd64

[VERSION]
B_GITVER https://github.com/jgraph/drawio

[BUILD]
rm -rf drawio
git clone --depth 1 --branch "v$B_VERSION" https://github.com/jgraph/drawio drawio
cd drawio/src/main
mkdir -p $B_INSTALLDIR/opt/drawio/
mv webapp $B_INSTALLDIR/opt/drawio/

[PKG]
type=deb
torepo=y

[DEB]
Package: drawio
Version: B_VERSION
Section: drawio
Priority: optional
Architecture: B_ARCH
Maintainer: B_MAIL
Description: DrawIO custom B_ORG build
Homepage: https://www.diagrams.net/
