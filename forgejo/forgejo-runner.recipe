[INFO]
arch=amd64

[VERSION]
# Forgejo Runner major releases change how workflows are executed, so stay on
# the current stable major line and bump it deliberately (same reasoning as the
# forgejo recipe staying on 15.0.x).
B_GITVER -i '^13\.' https://code.forgejo.org/forgejo/runner

[REQUIRED]
make golang-B_PF

[BUILD]
export GOROOT=/opt/go
export PATH=${PATH}:${GOROOT}/bin
# Keep the Go module cache out of srcguard's scan path
export GOMODCACHE=/tmp/vendor

B_GET git https://code.forgejo.org/forgejo/runner forgejo-runner
cd forgejo-runner
B_GITCHECKOUT v$B_VERSION

# Upstream derives the version it reports from `git describe` unless DRONE_TAG
# is set; pass it explicitly so the binary always reports the packaged version
# instead of relying on the (shallow) clone containing the tag.
make RELEASE_VERSION=$B_VERSION build

mkdir -p $B_INSTALLDIR/opt/forgejo-runner \
         $B_INSTALLDIR/usr/share/doc/forgejo-runner
cp forgejo-runner $B_INSTALLDIR/opt/forgejo-runner/forgejo-runner
B_LINKFILE /opt/forgejo-runner/forgejo-runner /usr/bin

# Ship the annotated example configuration generated by this exact binary, so
# the documented options cannot drift from the ones the binary understands.
./forgejo-runner generate-config > $B_INSTALLDIR/usr/share/doc/forgejo-runner/config.example.yaml

[PKG]
type=deb
torepo=y

[DEB]
Package: forgejo-runner
Version: B_VERSION
Section: forgejo
Priority: optional
Architecture: B_ARCH
Maintainer: B_MAIL
Homepage: https://forgejo.org/docs/latest/admin/actions/
Description: Forgejo Actions runner B_PF custom build
 Executes Forgejo Actions workflows fetched from a Forgejo instance. Jobs run
 in docker containers by default. The runner needs a uuid and token from the
 Forgejo instance before the daemon starts. Configuration lives in
 /etc/forgejo-runner, state (registration file and cache) in
 /var/lib/forgejo-runner.
Depends: docker.io
