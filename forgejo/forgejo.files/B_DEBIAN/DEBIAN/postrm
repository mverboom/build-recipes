#!/bin/sh

set -e

systemctl stop forgejo > /dev/null || true

# IMPORTANT: never delete the shared "git" user on purge.
# Forgejo's repositories and app data live under /var/git, the git user is
# shared with other tooling (cdist/ssh glue, the sshpiper key sync), and
# removing it would orphan all of that and break a reinstall. Data is left
# in place on purpose; remove it manually if you really mean to.
exit 0
