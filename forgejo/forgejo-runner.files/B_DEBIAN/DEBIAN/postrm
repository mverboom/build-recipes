#!/bin/sh
# Maintainer script for the Forgejo Actions runner package.
set -e

case "$1" in
    remove|purge)
        systemctl stop forgejo-runner > /dev/null 2>&1 || true
    ;;
esac

if [ "$1" = "purge" ]; then
    systemctl disable forgejo-runner > /dev/null 2>&1 || true

    if getent passwd forgejo-runner > /dev/null; then
        deluser --quiet --system forgejo-runner > /dev/null 2>&1 || \
            echo "Could not remove the forgejo-runner user." >&2
    fi
    if getent group forgejo-runner > /dev/null; then
        delgroup --quiet forgejo-runner > /dev/null 2>&1 || true
    fi

    # Registration file, cache and any job leftovers.
    rm -rf /var/lib/forgejo-runner
fi

exit 0
