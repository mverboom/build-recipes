[INFO]
arch=amd64

[VERSION]
B_GITVER -i '^15\.0\.' https://codeberg.org/forgejo/forgejo

[REQUIRED]
make golang-B_PF gcc nodejs-lts-B_PF

[BUILD]
export GOROOT=/opt/go
# Keep the Go module cache out of srcguard's scan path
export GOMODCACHE=/tmp/vendor
export PATH=${PATH}:${GOROOT}/bin
B_GET git https://codeberg.org/forgejo/forgejo forgejo
cd forgejo
git checkout v$B_VERSION
# Forgejo's Makefile defaults EXECUTABLE=gitea; ship a forgejo-named binary
TAGS="bindata timetzdata sqlite sqlite_unlock_notify" make build
cp -f gitea forgejo
mkdir -p $B_INSTALLDIR/opt/forgejo/
tar cfB - public templates forgejo | ( cd $B_INSTALLDIR/opt/forgejo ; tar xfB - )
B_LINKFILE /opt/forgejo/forgejo /usr/bin

[PKG]
type=deb
torepo=y

[DEB]
Package: forgejo
Version: B_VERSION
Section: forgejo
Priority: optional
Architecture: B_ARCH
Maintainer: B_MAIL
Homepage: https://forgejo.org
Description: Forgejo B_PF custom build
Depends: git
