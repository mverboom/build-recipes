[INFO]
arch=amd64

[VERSION]
B_GITVER https://github.com/FreeCAD/FreeCAD/

[REQUIRED]
curl

[BUILD]
# Resolve the x86_64 AppImage from the release's asset page instead of the
# REST API. This build has no GitHub credential and api.github.com is
# rate-limited: when it returns an error object the old jq filter died with
# "Cannot index string with string \"tag_name\"". The github.com asset page is
# not subject to the API rate limit.
assetpage=https://github.com/FreeCAD/FreeCAD/releases/expanded_assets/$B_VERSION
url=$( curl -s -L "$assetpage" | grep -oE 'href="/FreeCAD/FreeCAD/releases/download/[^"]*Linux-x86_64[^"]*\.AppImage"' | head -1 | sed 's/^href="//; s/"$//' )
[[ -n "$url" ]] || { echo "freecad: no Linux-x86_64 AppImage found for $B_VERSION"; exit 1; }
B_GET http "https://github.com${url}" freecad
chmod 755 freecad
./freecad --appimage-extract
mkdir -p "${B_INSTALLDIR}/opt/freecad"
cp -a squashfs-root/usr/. "${B_INSTALLDIR}/opt/freecad/"
B_LINKFILE /opt/freecad/bin/freecad /usr/bin
B_LINKFILE /opt/freecad/bin/freecadcmd /usr/bin

[SECURITY]
# Findings are all in third-party Python packages bundled inside the FreeCAD
# AppImage (pillow, pip, setuptools, urllib3, wheel, vtk, ...). None is at or
# above the CRITICAL enforce threshold; suppressed so the per-finding list does
# not flood every nightly build. A new CRITICAL advisory still fails the build.
vulnscan-ignore=GHSA-2fqr-mr3j-6wp8,GHSA-2vrm-gr82-f7m5,GHSA-38jv-5279-wg99,GHSA-3wq7-rqq7-wx6j,GHSA-45hq-cxwh-f6vc,GHSA-4fvr-rgm6-gqmc,GHSA-4m7w-qmgq-4wj5,GHSA-4x4j-2g7c-83w6,GHSA-54jq-c3m8-4m76,GHSA-58pv-8j8x-9vj2,GHSA-58qw-9mgm-455v,GHSA-5x94-69rx-g8h2,GHSA-5xmw-vc9v-4wf2,GHSA-62p4-gmf7-7g93,GHSA-63hf-3vf5-4wqf,GHSA-63hw-fmq6-xxg2,GHSA-65pc-fj4g-8rjx,GHSA-69f9-5gxw-wvc2,GHSA-6hr6-w5qg-qmwg,GHSA-6jhg-hg63-jvvf,GHSA-6mq8-rvhq-8wgg,GHSA-6r8x-57c9-28j4,GHSA-6v7p-g79w-8964,GHSA-6vgw-5pg2-w6jp,GHSA-8rrh-rw8j-w5fx,GHSA-8v84-f9pq-wr9x,GHSA-8v8h-hg4w-mvq2,GHSA-966j-vmvw-g2g9,GHSA-9hw9-ch79-4vh6,GHSA-9x8q-7h8h-wcw9,GHSA-c427-h43c-vf67,GHSA-cfh3-3jmp-rvhc,GHSA-cq5v-8q36-5273,GHSA-fh55-r93g-j68g,GHSA-fj7v-r99m-22gq,GHSA-g3cq-j2xw-wf74,GHSA-g84x-mcqj-x9qq,GHSA-gc5v-m9x4-r6x2,GHSA-h35f-9h28-mq5c,GHSA-hcc4-c3v8-rx92,GHSA-hg6j-4rv6-33pg,GHSA-hpj7-wq8m-9hgp,GHSA-jg22-mg44-37j8,GHSA-jj3x-wxrx-4x23,GHSA-jjj6-mw9f-p565,GHSA-jp4c-xjxw-mgf9,GHSA-m5qp-6w8w-w647,GHSA-m6qw-4cw2-hm4m,GHSA-mf9v-mfxr-j63j,GHSA-mfx4-hv73-q22v,GHSA-mq44-7p77-q5h7,GHSA-mqqc-3gqh-h2x8,GHSA-mwh4-6h8g-pg8w,GHSA-p998-jp59-783m,GHSA-pg7v-jwj7-p798,GHSA-phj9-mv4w-65pm,GHSA-pwv6-vv43-88gr,GHSA-qccp-gfcp-xxvc,GHSA-qwm4-qh6w-59xr,GHSA-r73j-pqj5-w3x7,GHSA-vfmq-68hx-4jfw,GHSA-vjc4-5qp5-m44j,GHSA-w2fm-2cpv-w7v5,GHSA-wf93-45jw-7689,GHSA-whj4-6x5x-4v2j,GHSA-wjx4-4jcj-g98j,GHSA-xcgm-r5h9-7989,GHSA-xj96-63gp-2gmr,PYSEC-2025-224,PYSEC-2025-225,PYSEC-2025-226,PYSEC-2026-1097,PYSEC-2026-1099,PYSEC-2026-1100,PYSEC-2026-1101,PYSEC-2026-1105,PYSEC-2026-1106,PYSEC-2026-1107,PYSEC-2026-1109,PYSEC-2026-141,PYSEC-2026-142,PYSEC-2026-1469,PYSEC-2026-165,PYSEC-2026-1796,PYSEC-2026-196,PYSEC-2026-1996,PYSEC-2026-2047,PYSEC-2026-2094,PYSEC-2026-2095,PYSEC-2026-2096,PYSEC-2026-2097,PYSEC-2026-2098,PYSEC-2026-2099,PYSEC-2026-2100,PYSEC-2026-2101,PYSEC-2026-2102,PYSEC-2026-2103,PYSEC-2026-2104,PYSEC-2026-2105,PYSEC-2026-2106,PYSEC-2026-2107,PYSEC-2026-2108,PYSEC-2026-2109,PYSEC-2026-2110,PYSEC-2026-2111,PYSEC-2026-2112,PYSEC-2026-2113,PYSEC-2026-215,PYSEC-2026-2249,PYSEC-2026-2250,PYSEC-2026-2251,PYSEC-2026-2252,PYSEC-2026-2253,PYSEC-2026-2254,PYSEC-2026-2255,PYSEC-2026-2256,PYSEC-2026-2257,PYSEC-2026-2275,PYSEC-2026-237,PYSEC-2026-2874,PYSEC-2026-2875,PYSEC-2026-2876,PYSEC-2026-3447,PYSEC-2026-3451,PYSEC-2026-3452,PYSEC-2026-3453,PYSEC-2026-3454,PYSEC-2026-3493,PYSEC-2026-3494,PYSEC-2026-3495,PYSEC-2026-3496,PYSEC-2026-3545,PYSEC-2026-3546,PYSEC-2026-3547,PYSEC-2026-3625,PYSEC-2026-3628,PYSEC-2026-3721,PYSEC-2026-87
# The AppImage bundles PostgreSQL's pgxs Makefile, whose DOWNLOAD helper
# mentions wget/curl. It is never executed by this build, so ignore the
# false-positive srcguard hit.
srcguard-ignore=squashfs-root/usr/lib/pgxs/src/Makefile.global

[PKG]
type=deb
torepo=y

[DEB]
Package: freecad
Version: B_VERSION
Section: freecad
Priority: optional
Architecture: B_ARCH
Maintainer: B_MAIL
Description: freecad custom B_ORG build
Homepage: https://www.freecad.org/
