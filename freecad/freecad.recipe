[INFO]
arch=amd64

[VERSION]
B_GITVER https://github.com/FreeCAD/FreeCAD/

[REQUIRED]
curl

[BUILD]
# Resolve the x86_64 AppImage from the release's asset page instead of the
# REST API. This build has no GitHub credential and api.github.com is
# rate-limited: when it returns an error object the old jq filter died with
# "Cannot index string with string \"tag_name\"". The github.com asset page is
# not subject to the API rate limit.
assetpage=https://github.com/FreeCAD/FreeCAD/releases/expanded_assets/$B_VERSION
url=$( curl -s -L "$assetpage" | grep -oE 'href="/FreeCAD/FreeCAD/releases/download/[^"]*Linux-x86_64[^"]*\.AppImage"' | head -1 | sed 's/^href="//; s/"$//' )
# NOTE: never start a line in a recipe section with "[". A section is
# extracted with awk "/^\[/ {found=0}", so a line beginning with "[" (the
# test/[[ builtin) silently ends the section: the remainder of BUILD is
# dropped and an empty package is produced without any error.
if [ -z "$url" ]; then
   echo "freecad: no Linux-x86_64 AppImage found for $B_VERSION"
   exit 1
fi
B_GET http "https://github.com${url}" freecad
chmod 755 freecad
./freecad --appimage-extract > /dev/null
# The AppImage bundles the Python packages that were current when upstream
# built it; that includes pillow 12.x, brotli < 1.2.1 and certifi <
# 2026.10.18, which vulnscan reports as CRITICAL. Upgrade them with the
# AppImage's own pip (it derives its prefix from its own location) before
# installing the tree.
squashfs-root/usr/bin/python -m pip install --no-cache-dir --upgrade \
   pillow brotli certifi urllib3 setuptools
mkdir -p "${B_INSTALLDIR}/opt/freecad"
cp -a squashfs-root/usr/. "${B_INSTALLDIR}/opt/freecad/"
B_LINKFILE /opt/freecad/bin/freecad /usr/bin
B_LINKFILE /opt/freecad/bin/freecadcmd /usr/bin

[SECURITY]
# With the vendored pillow/brotli/certifi/urllib3/setuptools upgraded in BUILD,
# no advisory is at or above CRITICAL. What remains are aiohttp, msgpack and
# multidict as bundled by upstream FreeCAD (HIGH and below), plus the pgxs
# Makefile inside the image, which is data and never executed.
vulnscan-ignore=GHSA-2g87-pp6c-29x5,GHSA-494j-54xm-rwp3,GHSA-54p9-h82j-f925,GHSA-5wr8-gcqf-gqf3,GHSA-6cjc-53gc-5rqm,GHSA-9xw5-w5jj-pvcg,GHSA-f9xw-jh8m-3mwq,GHSA-gx76-c99x-2c96,GHSA-j586-36cw-2gc2,GHSA-pqxq-w44r-73xw,PYSEC-2026-4244
srcguard-ignore=squashfs-root/usr/lib/pgxs/src/Makefile.global

[PKG]
type=deb
torepo=y

[DEB]
Package: freecad
Version: B_VERSION
Section: freecad
Priority: optional
Architecture: B_ARCH
Maintainer: B_MAIL
Description: freecad custom B_ORG build
Homepage: https://www.freecad.org/
