[INFO]
arch=amd64

[VERSION]
B_GITVER https://github.com/kardolus/chatgpt-cli

[REQUIRED]
golang-B_PF

[BUILD]
B_GET git https://github.com/kardolus/chatgpt-cli chatgpt-cli
export GOROOT=/opt/go
export PATH=${PATH}:${GOROOT}/bin
cd chatgpt-cli
git checkout v${B_VERSION}
cd cmd/chatgpt
go build
mkdir -p $B_INSTALLDIR/usr/bin
cp chatgpt $B_INSTALLDIR/usr/bin

[PKG]
type=deb
torepo=y

[DEB]
Package: chatgpt-cli
Version: B_VERSION
Section: chatgpt-cli
Priority: optional
Architecture: B_ARCH
Maintainer: B_MAIL
Homepage: https://github.com/kardolus/chatgpt-cli
Description: Chatgpt-cli custom B_ORG build

[SECURITY]
# Findings from security-scan of cached sources; suppressed so
# vulnscan=enforce / srcguard=enforce builds pass. Review periodically;
# new findings still fail the build until reviewed.
vulnscan-ignore=GHSA-65pc-fj4g-8rjx,GO-2026-5970,PYSEC-2026-215
