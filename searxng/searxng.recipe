[INFO]
arch=amd64

[VERSION]
B_GITHUBVER https://github.com/searxng/searxng

[REQUIRED]
python3-dev python3-babel python3-venv uwsgi uwsgi-plugin-python3 build-essential libxslt1-dev zlib1g-dev libffi-dev libssl-dev

[BUILD DEBIAN]
set -o pipefail
B_GET git https://github.com/searxng/searxng searxng
cd searxng
DEST=$B_INSTALLDIR/opt/searxng
python3 -m venv "$DEST"
. "$DEST/bin/activate"

# Pre-install build dependencies (required because setup.py imports them at module level)
pip3 install --no-cache -r requirements.txt
pip3 install -U pip setuptools wheel pyyaml msgspec typing-extensions pybind11

# NON-editable install -- this places searx/ into site-packages
pip3 install --no-build-isolation .

deactivate

# Rewrite hardcoded paths in bin scripts from build path to /opt/searxng
pushd "$DEST/bin"
shopt -s extglob
sed -i "s|$DEST|/opt/searxng|g" !(__pycache__)
popd

# Copy the settings file for configuration
mkdir -p "$B_INSTALLDIR/etc/searxng"
cp searx/settings.yml "$B_INSTALLDIR/etc/searxng/settings.yml.example"


[PKG]
type=deb
torepo=y

[DEB]
Package: searxng
Version: B_VERSION
Section: searxng
Priority: optional
Architecture: B_ARCH
Maintainer: B_MAIL
Description: Searxng custom B_ORG build
Homepage: https://github.com/searxng/searxng
Depends: redis,git

[SECURITY]
# Findings from security-scan of cached sources; suppressed so
# vulnscan=enforce / srcguard=enforce builds pass. Review periodically;
# new findings still fail the build until reviewed.
vulnscan-ignore=GHSA-2v37-7h3g-55p8,GHSA-3936-cmfr-pm3m,GHSA-4c8g-83qw-93j6,GHSA-5p4m-2wfm-xmqj,GHSA-5rjg-fvgr-3xxf,GHSA-65pc-fj4g-8rjx,GHSA-7p8r-x3mc-p8w7,GHSA-cx63-2mw6-8hw5,GHSA-fxqj-rqcc-2cmp,GHSA-h35f-9h28-mq5c,GHSA-q3j6-qgpj-74h6,GHSA-r9hx-vwmv-q579,GHSA-v2hh-gcrm-f6hx,GHSA-v39h-62p7-jpjc,GO-2026-5024,PYSEC-2022-43012,PYSEC-2025-49,PYSEC-2026-1918,PYSEC-2026-2120,PYSEC-2026-2121,PYSEC-2026-215,PYSEC-2026-3447
