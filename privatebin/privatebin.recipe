[INFO]
arch=all

[VERSION]
B_GITVER https://github.com/PrivateBin/PrivateBin

[BUILD]
B_GET git https://github.com/PrivateBin/PrivateBin privatebin
cd privatebin
git checkout $B_VERSION
mkdir -p $B_INSTALLDIR/opt/privatebin/htdocs
mkdir -p $B_INSTALLDIR/opt/privatebin/privatebin
mkdir -p $B_INSTALLDIR/var/lib/privatebin
mv doc lib tpl tst vendor $B_INSTALLDIR/opt/privatebin/privatebin
sed -i "s/'PATH', ''/'PATH', '\/opt\/privatebin\/privatebin\/\/'/" index.php
mv css i18n img js index.php $B_INSTALLDIR/opt/privatebin/htdocs
mkdir -p $B_INSTALLDIR/etc/privatebin
cat cfg/conf.sample.php | sed 's/dir = PATH "data"/dir = "\/var\/lib\/privatebin"/' > $B_INSTALLDIR/etc/privatebin/conf.php

[PKG]
type=deb
torepo=y

[DEB]
Package: privatebin
Version: B_VERSION
Section: privatebin
Priority: optional
Architecture: B_ARCH
Maintainer: B_MAIL
Homepage: https://privatebin.info/
Description: privatebin B_PF custom build

[SECURITY]
# Findings from security-scan of cached sources; suppressed so
# vulnscan=enforce / srcguard=enforce builds pass. Review periodically;
# new findings still fail the build until reviewed.
vulnscan-ignore=GHSA-23c5-xmqv-rm74,GHSA-3jxr-9vmj-r5cp,GHSA-3ppc-4f35-3m26,GHSA-4x5r-pxfx-6jf8,GHSA-52cp-r559-cp3m,GHSA-5c6j-r48x-rmvq,GHSA-5p4m-2wfm-xmqj,GHSA-73rr-hh4g-fpgx,GHSA-7r86-cg39-jmmj,GHSA-f23m-r3pf-42rh,GHSA-h67p-54hq-rp68,GHSA-mh99-v99m-4gvg,GHSA-qj8w-gfj5-8c6v,GHSA-r5fr-rjxr-66jc,GHSA-rgw5-rvv9-x895
