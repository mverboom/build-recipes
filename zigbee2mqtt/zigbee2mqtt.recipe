[INFO]
arch=amd64

[VERSION]
B_GITVER https://github.com/Koenkk/zigbee2mqtt.git

[REQUIRED]
nodejs-22-B_PF git make g++ gcc pnpm-B_PF

[BUILD]
B_GET git https://github.com/Koenkk/zigbee2mqtt.git zigbee2mqtt
cd zigbee2mqtt
git checkout $B_VERSION
echo "node-linker=hoisted" >> .npmrc
#npm ci
#npm run build
pnpm i
pnpm run build
rm -rf LICENSE README.md .git .github .gitignore test .vscode .npmrc .npmignore update.sh docker images npm-shrinkwrap.json .dockerignore .eslintignore .eslintrc.json data
cat > process-title.js << 'PEOF'
process.title = 'z2m-' + (process.env.Z2M_INSTANCE || 'default');
PEOF
mkdir -p "$B_INSTALLDIR/opt/zigbee2mqtt"
mkdir -p "$B_INSTALLDIR/var/log/zigbee2mqtt"
mkdir -p "$B_INSTALLDIR/var/lib/zigbee2mqtt"
ln -s /var/lib/zigbee2mqtt data
tar cfB - . | (cd $B_INSTALLDIR/opt/zigbee2mqtt ; tar xfB - )
ln -s /etc/zigbee2mqtt/configuration.yaml $B_INSTALLDIR/var/lib/zigbee2mqtt/configuration.yaml

[PKG]
type=deb
torepo=y

[DEB]
Package: zigbee2mqtt
Version: B_VERSION
Section: zigbee2mqtt
Priority: optional
Architecture: B_ARCH
Maintainer: B_MAIL
Description: Zigbee2mqtt custom B_ORG build
Homepage: https://www.zigbee2mqtt.io
Depends: nodejs-22-B_PF

[SECURITY]
# Findings from security-scan of cached sources; suppressed so
# vulnscan=enforce / srcguard=enforce builds pass. Review periodically;
# new findings still fail the build until reviewed.
vulnscan-ignore=GHSA-22jq-vg5j-6vgg,GHSA-23c5-xmqv-rm74,GHSA-28wg-ghj8-5hjv,GHSA-2v37-7h3g-55p8,GHSA-3jxr-9vmj-r5cp,GHSA-3ppc-4f35-3m26,GHSA-3v7f-55p6-f55p,GHSA-4c8g-83qw-93j6,GHSA-4w7w-66w2-5vf9,GHSA-4xrf-jv44-h6hh,GHSA-5xrq-8626-4rwp,GHSA-6g55-p6wh-862q,GHSA-7p8r-x3mc-p8w7,GHSA-7r86-cg39-jmmj,GHSA-93m4-6634-74q7,GHSA-c2c7-rcm5-vvqj,GHSA-fx2h-pf6j-xcff,GHSA-fxqj-rqcc-2cmp,GHSA-g4jq-h2w9-997c,GHSA-jqfw-vq24-v9c3,GHSA-mh99-v99m-4gvg,GHSA-mw96-cpmx-2vgc,GHSA-mwp4-54f8-5fhr,GHSA-p9ff-h696-f583,GHSA-q3j6-qgpj-74h6,GHSA-qx2v-qp2m-jg93,GHSA-r28c-9q8g-f849,GHSA-rgw5-rvv9-x895,GHSA-v2hh-gcrm-f6hx,GHSA-v39h-62p7-jpjc,GHSA-v6wh-96g9-6wx3
