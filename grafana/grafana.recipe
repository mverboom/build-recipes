[INFO]
arch=amd64

[VERSION]
B_GITVER https://github.com/grafana/grafana

[REQUIRED]
golang-B_PF gcc nodejs-B_PF g++ make yarn-B_PF

[BUILD]
# 20250815 MV: Seems to require nodejs v22.16 specifically
# 20200207 MV: Prevent memory debug error
GODEBUG=asyncpreemptoff=1
export PUPPETEER_SKIP_DOWNLOAD=1

export GOROOT=/opt/go
export PATH=${PATH}:${GOROOT}/bin
export GOPATH=$(pwd)

mkdir -p src/github.com/grafana
pushd src/github.com/grafana
B_GET git https://github.com/grafana/grafana grafana
cd grafana
git checkout v$B_VERSION
# 20260415 Change for grafana 13
#make gen-go
make build-go GO_BUILD_TAGS=oss WIRE_TAGS=oss
#go run build.go setup
#go run build.go build

export NODE_OPTIONS="--max_old_space_size=8000"
export NODE_ENV=production
yarn install
yarn build

mkdir -p $B_INSTALLDIR/opt/grafana/bin $B_INSTALLDIR/etc/grafana
tar cfB - public | (cd $B_INSTALLDIR/opt/grafana ; tar xfB - )
cd conf
tar cfB - defaults.ini provisioning | (cd $B_INSTALLDIR/etc/grafana; tar xfB - )
cd ..
#cp bin/linux-amd64/grafana-server $B_INSTALLDIR/opt/grafana/bin
#cp bin/linux-amd64/grafana-cli $B_INSTALLDIR/opt/grafana/bin
#cp bin/linux-amd64/grafana $B_INSTALLDIR/opt/grafana/bin
cp bin/grafana $B_INSTALLDIR/opt/grafana/bin
popd
ln -s /etc/grafana $B_INSTALLDIR/opt/grafana/conf

[PKG]
type=deb
torepo=y

[DEB]
Package: grafana
Version: B_VERSION
Section: grafana
Priority: optional
Architecture: B_ARCH
Maintainer: B_MAIL
Description: Grafana custom B_ORG build
Homepage: https://grafana.com

[SECURITY]
# Findings from security-scan of cached sources; suppressed so
# vulnscan=enforce / srcguard=enforce builds pass. Review periodically;
# new findings still fail the build until reviewed.
vulnscan-ignore=GHSA-2g4f-4pwh-qvx6,GHSA-2v37-7h3g-55p8,GHSA-337j-9hxr-rhxg,GHSA-4x5r-pxfx-6jf8,GHSA-5p4m-2wfm-xmqj,GHSA-5v7r-6r5c-r473,GHSA-ffqx-q65f-36jf,GHSA-frvp-7c67-39w9,GHSA-g2r8-wvmj-jf5w,GHSA-g7r4-m6w7-qqqr,GHSA-hfg8-hc9c-6c3h,GHSA-hrxh-6v49-42gf,GHSA-jjmj-jmhj-qwj2,GHSA-p4r4-xvrq-gvmc,GHSA-q7cg-457f-vx79,GHSA-v422-hmwv-36x6,GHSA-v6wh-96g9-6wx3,GHSA-vp3h-ghgh-jr7g,GHSA-vpq2-c234-7xj6,GHSA-w5hq-g745-h8pq,GHSA-wrjc-x8rr-h8h6,GO-2022-0635,GO-2022-0646,GO-2026-5024,GO-2026-5158,GO-2026-5359,GO-2026-5528,GO-2026-5841,GO-2026-5932,GO-2026-5942,GO-2026-5970,GO-2026-6061,GO-2026-6094,GO-2026-6107,GO-2026-6179,GO-2026-6180
srcguard-ignore=grafana/apps/advisor/Makefile,grafana/apps/sdk.mk,grafana/docs/docs.mk,grafana/Makefile
