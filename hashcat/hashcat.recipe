[INFO]
arch=amd64

[VERSION]
B_GITVER https://github.com/hashcat/hashcat

[REQUIRED]
make gcc g++

[BUILD]
B_GET git https://github.com/hashcat/hashcat hashcat
cd hashcat
git checkout v${B_VERSION}
make PREFIX=/opt/hashcat -j $(nproc)
make install PREFIX=/opt/hashcat DESTDIR=$B_INSTALLDIR
B_LINKFILES /opt/hashcat/bin /usr/bin

[PKG]
type=deb
torepo=y

[DEB]
Package: hashcat
Version: B_VERSION
Section: hashcat
Priority: optional
Architecture: B_ARCH
Maintainer: B_MAIL
Description: hashcat custom B_ORG build
Homepage: https://hashcat.net/
Depends: pocl-opencl-icd

[SECURITY]
# Findings from security-scan of cached sources; suppressed so
# vulnscan=enforce / srcguard=enforce builds pass. Review periodically;
# new findings still fail the build until reviewed.
vulnscan-ignore=CVE-2018-25018,CVE-2026-22184,CVE-2026-27171,CVE-2026-3381,GHSA-3288-p39f-rqpv,RUSTSEC-2026-0012
srcguard-ignore=hashcat/deps/zlib/contrib/puff/Makefile
