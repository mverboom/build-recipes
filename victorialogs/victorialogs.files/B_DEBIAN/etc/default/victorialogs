# Command line options for victoria-logs, read by victorialogs.service.
# Full list: /opt/victorialogs/bin/victoria-logs -help
# Docs: https://docs.victoriametrics.com/victorialogs/#list-of-command-line-flags
#
# The DAEMON_OPTS line below is the generic default. The commented flags after
# it are common site tuning; append the ones you want to DAEMON_OPTS.
DAEMON_OPTS="-storageDataPath=/var/lib/victorialogs -httpListenAddr=:9428 -retentionPeriod=1y -retention.maxDiskSpaceUsageBytes=8GiB -syslog.listenAddr.udp=:9514"

# Receive syslog on the standard privileged port; the unit already grants CAP_NET_BIND_SERVICE.
# -syslog.listenAddr.udp=:514
# Also receive syslog over TCP (off by default; same port by convention).
# -syslog.listenAddr.tcp=:514
# Timezone for RFC3164 timestamps, which carry none; defaults to the local zone.
# -syslog.timezone=Europe/Amsterdam
# Extra journald fields to key streams on; fqdn allows per-host query pruning.
# -journald.streamFields=_MACHINE_ID,fqdn
# Serve every HTTP path under this prefix, for a reverse proxy that passes it through.
# -http.pathPrefix=/victorialogs
# Cap on the in-memory caches; too low raises disk IO, too high evicts the page cache.
# -memory.allowedBytes=256MB
# Stop accepting writes once free disk falls below this, before retention has to act.
# -storage.minFreeDiskSpaceBytes=1GB
# Go heap limit; VictoriaLogs sizes against host RAM, not the container, so keep it below the container limit.
# GOMEMLIMIT=3GiB
