[INFO]
arch=amd64

[VERSION]
B_GITVER -e citest https://github.com/ollama/ollama/

[REQUIRED]
golang-B_PF gcc g++ make cmake
#golang-B_PF gcc g++ make cmake nvidia-cuda-toolkit-gcc

[BUILD]
export GOROOT=/opt/go
export PATH=/opt/go/bin:$PATH
B_GET git https://github.com/ollama/ollama/ ollama
cd ollama
git checkout v$B_VERSION

# Build the native payload (llama-server, shared libs, CPU backends) via cmake superbuild
# Also builds the Go binary with embedded version info
# NOTE: env -u DESTDIR -- the build system exports DESTDIR (~/build) into the
# container. cmake --install prepends $DESTDIR to every destination, which
# breaks ollama's superbuild: its internal staging area uses the absolute
# path $CMAKE_BINARY_DIR/lib/ollama, and a DESTDIR prefix sends the staged
# payloads to the wrong place while the top-level install then cannot find
# them. Strip DESTDIR from cmake's environment so installs land where
# CMAKE_INSTALL_PREFIX (= $B_INSTALLDIR/opt/ollama) points.
env -u DESTDIR cmake -DCMAKE_INSTALL_PREFIX=$B_INSTALLDIR/opt/ollama -DOLLAMA_VERSION=$B_VERSION --preset 'Default'
env -u DESTDIR cmake --build --parallel $(nproc) --preset 'Default'

# Install the Go binary and all native payloads
# The component name is ollama-local per cmake/local.cmake
env -u DESTDIR cmake --install build --component ollama-local

B_LINKFILE /opt/ollama/bin/ollama /usr/bin

[PKG]
type=deb
torepo=y

[DEB]
Package: ollama
Version: B_VERSION
Section: ollama
Priority: optional
Architecture: B_ARCH
Depends: libc6 (>= 2.36), libstdc++6 (>= 12), libgcc-s1
Maintainer: B_MAIL
Homepage: https://ollama.com/
Description: ollama B_PF custom build
