[INFO]
arch=amd64

[SECURITY]
# framework_uefi/Makefile (not built: workspace default-members are only
# framework_lib + framework_tool) downloads UEFI shell/OVMF firmware via curl
# from official sources. Legitimate build-time downloads, not the XZ pattern.
srcguard=enforce
srcguard-ignore=framework-system/framework_uefi/Makefile
# proc-macro-error2 (transitive build-time dep via clap_derive) is unmaintained;
# informational advisory, no patched version exists, not shipped in the package.
vulnscan-ignore=RUSTSEC-2026-0173

[VERSION]
B_GITHUBVER https://github.com/FrameworkComputer/framework-system main

[REQUIRED]
rustc-B_PF gcc libudev-dev pkg-config

[BUILD]
B_GET git https://github.com/FrameworkComputer/framework-system framework-system
cd framework-system
cargo build
mkdir -p $B_INSTALLDIR/usr/bin
cp target/debug/framework_tool $B_INSTALLDIR/usr/bin

[PKG]
type=deb
torepo=y

[DEB]
Package: framework-tool
Version: B_VERSION
Section: framework-tool
Priority: optional
Architecture: B_ARCH
Maintainer: B_MAIL
Description: Framework-tool server custom B_ORG build
Homepage: https://github.com/FrameworkComputer/framework-system
