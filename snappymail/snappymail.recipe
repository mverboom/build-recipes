[INFO]
arch=any

[VERSION]
B_GITVER https://github.com/the-djmaze/snappymail

[REQUIRED]
gulp-B_PF nodejs-lts-B_PF yarn-B_PF

[BUILD]
B_GET git https://github.com/the-djmaze/snappymail snappymail
cd snappymail
git checkout v${B_VERSION}
sed -i "s/0.0.0/${B_VERSION}/" index.php
mv snappymail/v/0.0.0 snappymail/v/${B_VERSION}
yarn install
gulp
rm -rf .git .github .gitignore docker-compose.yml
cat > include.php <<EOF
<?php
define('APP_DATA_FOLDER_PATH', '/var/lib/snappymail/data/');
EOF

mkdir -p $B_INSTALLDIR/opt/snappymail $B_INSTALLDIR/var/lib/snappymail/data
tar cf - . | tar -C $B_INSTALLDIR/opt/snappymail -xf -

[PKG]
type=deb
torepo=y

[DEB]
Package: snappymail
Version: B_VERSION
Section: snappymail
Priority: optional
Architecture: B_ARCH
Maintainer: B_MAIL
Description: snappymail custom B_ORG build
Homepage: https://github.com/the-djmaze/snappymail

[SECURITY]
# Findings from security-scan of cached sources; suppressed so
# vulnscan=enforce / srcguard=enforce builds pass. Review periodically;
# new findings still fail the build until reviewed.
vulnscan-ignore=GHSA-23c5-xmqv-rm74,GHSA-25h7-pfq9-p65f,GHSA-2g4f-4pwh-qvx6,GHSA-3jxr-9vmj-r5cp,GHSA-3ppc-4f35-3m26,GHSA-3v7f-55p6-f55p,GHSA-3xgq-45jj-v275,GHSA-52cp-r559-cp3m,GHSA-52f5-9888-hmc6,GHSA-5c6j-r48x-rmvq,GHSA-5p2g-fcmc-qvqq,GHSA-5p4m-2wfm-xmqj,GHSA-7r86-cg39-jmmj,GHSA-952p-6rrq-rcjv,GHSA-c2c7-rcm5-vvqj,GHSA-f23m-r3pf-42rh,GHSA-f886-m6hf-6m8v,GHSA-gcx4-mw62-g8wm,GHSA-h67p-54hq-rp68,GHSA-mh29-5h37-fv8m,GHSA-mh99-v99m-4gvg,GHSA-mw96-cpmx-2vgc,GHSA-ph9p-34f9-6g65,GHSA-r5fr-rjxr-66jc,GHSA-rf6f-7fwh-wjgh,GHSA-rgw5-rvv9-x895,GHSA-v6h2-p8h4-qcjw,GHSA-w3rx-r6r6-pgpr,GHSA-xxjr-mmjv-4gpg
