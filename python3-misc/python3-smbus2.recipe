[VERSION]
B_GITVER https://github.com/kplindegaard/smbus2

[INFO]
arch=amd64

[REQUIRED]
python3-setuptools

[BUILD DEBIAN]
B_GET git https://github.com/kplindegaard/smbus2 smbus2
cd smbus2
git checkout $B_VERSION
python3 setup.py install --root=$B_INSTALLDIR --install-layout deb

[PKG]
type=deb
torepo=y

[DEB]
Package: python3-smbus2
Version: B_VERSION
Section: python3
Priority: optional
Architecture: B_ARCH
Maintainer: B_MAIL
Description: Python3 smbus2 custom B_ORG build
Homepage: https://github.com/kplindegaard/smbus2
Depends: python3

[SECURITY]
# Findings from security-scan of cached sources; suppressed so
# vulnscan=enforce / srcguard=enforce builds pass. Review periodically;
# new findings still fail the build until reviewed.
vulnscan-ignore=GHSA-65pc-fj4g-8rjx,PYSEC-2026-215
