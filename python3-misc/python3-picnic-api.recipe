[VERSION]
B_GITHUBVER https://github.com/MikeBrink/python-picnic-api

[INFO]
arch=amd64

[REQUIRED]
python3-setuptools

[BUILD DEBIAN]
B_GET git https://github.com/MikeBrink/python-picnic-api picnic-api
cd picnic-api
DEST=$B_INSTALLDIR/usr/lib/python3/dist-packages/python_picnic_api
mkdir -p $DEST
cp python_picnic_api/* $DEST

[PKG]
type=deb
torepo=y

[DEB]
Package: python3-picnic-api
Version: B_VERSION
Section: python3
Priority: optional
Architecture: B_ARCH
Maintainer: B_MAIL
Description: Python3 picnic api custom B_ORG build
Homepage: https://github.com/MikeBrink/python-picnic-api
Depends: python3,python3-requests

[SECURITY]
# Findings from security-scan of cached sources; suppressed so
# vulnscan=enforce / srcguard=enforce builds pass. Review periodically;
# new findings still fail the build until reviewed.
vulnscan-ignore=GHSA-2xpw-w6gg-jr37,GHSA-34jh-p97f-mpxf,GHSA-38jv-5279-wg99,GHSA-43fp-rhv2-5gv8,GHSA-5phf-pp7p-vc2r,GHSA-65pc-fj4g-8rjx,GHSA-6w46-j5rx-g56g,GHSA-9hjg-9r4m-mvj7,GHSA-9wx4-h78v-vm56,GHSA-fj7x-q9j7-g6q6,GHSA-g4mx-q9vg-27p4,GHSA-gc5v-m9x4-r6x2,GHSA-gm62-xv2j-4w53,GHSA-hj5v-574p-mj7c,GHSA-j8r2-6x86-q33q,GHSA-jfmj-5v4g-7637,GHSA-jjg7-2v4v-x38h,GHSA-mf9w-mj56-hr94,GHSA-pq67-6m6q-mj2v,GHSA-q2q7-5pp4-w6pg,GHSA-qccp-gfcp-xxvc,GHSA-v845-jxx5-vc9f,GHSA-xqr8-7jwr-rhp7,PYSEC-2020-92,PYSEC-2021-108,PYSEC-2021-59,PYSEC-2022-42986,PYSEC-2023-135,PYSEC-2023-192,PYSEC-2023-212,PYSEC-2023-74,PYSEC-2024-230,PYSEC-2024-48,PYSEC-2024-60,PYSEC-2026-141,PYSEC-2026-1845,PYSEC-2026-1872,PYSEC-2026-1873,PYSEC-2026-1994,PYSEC-2026-1995,PYSEC-2026-1996,PYSEC-2026-1998,PYSEC-2026-1999,PYSEC-2026-2074,PYSEC-2026-2120,PYSEC-2026-2121,PYSEC-2026-2132,PYSEC-2026-215,PYSEC-2026-2270,PYSEC-2026-2275
