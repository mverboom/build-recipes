[INFO]
arch=amd64

[VERSION]
B_GITVER -D -r "/^v/!d" https://github.com/bastienwirtz/homer

[REQUIRED]
nodejs-lts-B_PF
#yarn-B_PF

[BUILD]
B_GET git https://github.com/bastienwirtz/homer homer
mkdir corepack
corepack enable --install-directory corepack
export PATH=$(pwd)/corepack:$PATH
cd homer
git checkout v$B_VERSION
pnpm install
pnpm build
cd dist
mkdir -p $B_INSTALLDIR/opt/homer $B_INSTALLDIR/etc
mv assets $B_INSTALLDIR/etc/homer
mv * $B_INSTALLDIR/opt/homer
B_GET git https://github.com/NX211/homer-icons/ icons
mv icons/svg/* $B_INSTALLDIR/etc/homer/icons
mv icons/png/* $B_INSTALLDIR/etc/homer/icons
ln -s /etc/homer $B_INSTALLDIR/opt/homer/assets

[PKG]
type=deb
torepo=y

[DEB]
Package: homer
Version: B_VERSION
Section: homer
Priority: optional
Architecture: B_ARCH
Maintainer: B_MAIL
Description: Homer custom B_ORG build
Homepage: https://github.com/bastienwirtz/homer

[SECURITY]
# Findings from security-scan of cached sources; suppressed so
# vulnscan=enforce / srcguard=enforce builds pass. Review periodically;
# new findings still fail the build until reviewed.
vulnscan-ignore=GHSA-25h7-pfq9-p65f,GHSA-28wg-ghj8-5hjv,GHSA-2v37-7h3g-55p8,GHSA-3jxr-9vmj-r5cp,GHSA-5c6j-r48x-rmvq,GHSA-6rw7-vpxm-498p,GHSA-fxqj-rqcc-2cmp,GHSA-jxxr-4gwj-5jf2,GHSA-mh99-v99m-4gvg,GHSA-q8mj-m7cp-5q26,GHSA-qj8w-gfj5-8c6v,GHSA-r28c-9q8g-f849,GHSA-r4q5-vmmm-2653,GHSA-rf6f-7fwh-wjgh,GHSA-rgw5-rvv9-x895,GHSA-v56q-mh7h-f735,GHSA-w7fw-mjwx-w883,GHSA-xvcm-6775-5m9r
