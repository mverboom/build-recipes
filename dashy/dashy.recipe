[INFO]
arch=amd64

[VERSION]
B_GITVER https://github.com/Lissy93/dashy

[REQUIRED]
nodejs-lts-B_PF

[BUILD]
B_GET git https://github.com/Lissy93/dashy dashy
cd dashy
git checkout $B_VERSION

# Build the frontend with the full (dev) dependency set.
# Dashy is served from a sub-directory (https://secure.verboom.net/dashy/), which
# upstream does not support out of the box (Lissy93/dashy#1036). The patch makes
# the few hardcoded absolute URLs relative to the Vite base path; the base
# itself comes from the flag on the build command below. The patch must apply
# cleanly: a new upstream version that changes these lines fails the build here
# instead of shipping a dashboard that loads its assets from the wrong place.
patch -p1 --forward < $B_FILES/dashy-base-path.patch
npm install
npm run build -- --base=/dashy/

# Install the application the same way as the upstream Docker image, so the
# server's hardcoded paths resolve: rootDir = dirname(services)/.. = /opt/dashy
# and it serves dist/ and public/ relative to that.
mkdir -p $B_INSTALLDIR/opt/dashy/src/utils/config
cp -r dist $B_INSTALLDIR/opt/dashy/
cp -r public $B_INSTALLDIR/opt/dashy/
cp -r services $B_INSTALLDIR/opt/dashy/
cp src/utils/config/ConfigSchema.json $B_INSTALLDIR/opt/dashy/src/utils/config/
cp server.js package.json $B_INSTALLDIR/opt/dashy/

# Default config, seeded into /var/lib/dashy on first install and never
# overwritten afterwards (the web UI edits the live copy).
install -D -m 0644 user-data/conf.yml $B_INSTALLDIR/usr/share/dashy/conf.yml.default

# Drop the dev dependencies but keep the exact versions that were just used to
# build (mirrors the Dockerfile "deps" stage, without a lockfile to re-resolve).
npm prune --omit=dev
cp -r node_modules $B_INSTALLDIR/opt/dashy/

# Runtime data: the writable config (USER_DATA_DIR) and its backups.
mkdir -p $B_INSTALLDIR/var/lib/dashy/config-backups

# One config file for both modes. The Node server reads it as
# USER_DATA_DIR/conf.yml; in standalone mode nginx serves the same file through
# the symlink below. /etc/dashy keeps the historical path for convenience.
mkdir -p $B_INSTALLDIR/etc/dashy
ln -sf /var/lib/dashy/conf.yml $B_INSTALLDIR/etc/dashy/conf.yml
ln -sf /var/lib/dashy/conf.yml $B_INSTALLDIR/opt/dashy/dist/conf.yml

[PKG]
type=deb
torepo=y

[DEB]
Package: dashy
Version: B_VERSION
Section: dashy
Priority: optional
Architecture: B_ARCH
Maintainer: B_MAIL
Description: Dashy custom B_ORG build
Homepage: https://dashy.to
Depends: nodejs-lts-B_PF
