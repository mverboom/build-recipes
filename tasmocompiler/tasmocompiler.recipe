[INFO]
arch=amd64
excludefromall=1

[VERSION]
B_GITVER https://github.com/benzino77/tasmocompiler

[REQUIRED]
nodejs-12-B_PF yarn-B_PF

[BUILD]
B_GET git https://github.com/benzino77/tasmocompiler tasmocompiler
cd tasmocompiler
git checkout v${B_VERSION}
yarn install
yarn build
rm -rf .git .github .gitignore .gitpod.Dockerfile .gitpod.yml .yarnrc src build_docker.sh README.md TRANSLATION.md .vscode yarn.lock ADVANCED.md Dockerfile Pipfile Pipfile.lock
mkdir -p $B_INSTALLDIR/opt/tasmocompiler
rm -rf server/config
ln -s /etc/tasmocompiler server/config
tar cfB - . | (cd $B_INSTALLDIR/opt/tasmocompiler ; tar xfB - )

[PKG]
type=deb
torepo=y

[DEB]
Package: tasmocompiler
Version: B_VERSION
Section: tasmocompiler
Priority: optional
Architecture: B_ARCH
Maintainer: B_MAIL
Description: Tasmocompiler custom B_ORG build
Homepage: https://github.com/benzino77/tasmocompiler
Depends: platformio-core-B_PF, nodejs-12-B_PF, git

[SECURITY]
# Findings from security-scan of cached sources; suppressed so
# vulnscan=enforce / srcguard=enforce builds pass. Review periodically;
# new findings still fail the build until reviewed.
vulnscan-ignore=GHSA-2p49-hgcm-8545,GHSA-2v35-w6hq-6mfw,GHSA-4v9v-hfq4-rm2v,GHSA-5c6j-r48x-rmvq,GHSA-6g55-p6wh-862q,GHSA-79cf-xcqc-c78w,GHSA-7fh5-64p2-3v2j,GHSA-9jgg-88mc-972h,GHSA-c2qf-rxjj-qqgw,GHSA-f5vj-f2hx-8m93,GHSA-f6ww-3ggp-fr8h,GHSA-fxqj-rqcc-2cmp,GHSA-j759-j44w-7fr8,GHSA-m28w-2pqf-7qgj,GHSA-mx8g-39q3-5c79,GHSA-pxg6-pf52-xh8x,GHSA-qj8w-gfj5-8c6v,GHSA-qpx9-hpmf-5gmw,GHSA-qx2v-qp2m-jg93,GHSA-r28c-9q8g-f849,GHSA-rp65-9cf3-cjxr,GHSA-vpq2-c234-7xj6,GHSA-w5hq-g745-h8pq,GHSA-wh4c-j3r5-mjhp,GHSA-x6wf-f3px-wcqx
