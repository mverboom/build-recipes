#!/bin/sh

set -e

if [ "$1" = "purge" ] ; then
    systemctl stop speedtest-go 2>/dev/null || true
    if getent passwd speedtest-go >/dev/null; then
        if which deluser >/dev/null 2>&1; then
            deluser --quiet --system speedtest-go || echo "Could not remove speedtest-go user."
        fi
    fi
    rm -rf /var/lib/speedtest-go
fi

exit 0
