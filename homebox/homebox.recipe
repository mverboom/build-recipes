[INFO]
arch=amd64

[VERSION]
B_GITVER https://github.com/sysadminsmedia/homebox/

[REQUIRED]
make golang-B_PF nodejs-lts-B_PF pnpm-B_PF

[BUILD]
export GOROOT=/opt/go
export PATH=${PATH}:${GOROOT}/bin
B_GET git https://github.com/sysadminsmedia/homebox/ homebox
cd homebox
git checkout v$B_VERSION

mkdir -p $B_INSTALLDIR/usr/bin

cd frontend
pnpm install --frozen-lockfile
pnpm build

cd ../backend
cp -r ../frontend/.output/public app/api/static/
go mod download
CGO_ENABLED=0 GOOS=linux go build -ldflags "-s -w -X main.version=$B_VERSION -X main.commit=$(git rev-parse --short HEAD) -X main.buildTime=$(date "+%Y%m%d")" -o $B_INSTALLDIR/usr/bin/homebox -v app/api/*go

[PKG]
type=deb
torepo=y

[DEB]
Package: homebox
Version: B_VERSION
Section: homebox
Priority: optional
Architecture: B_ARCH
Maintainer: B_MAIL
Homepage: https://github.com/sysadminsmedia/homebox
Description: Homebox B_PF custom build

[SECURITY]
# Findings from security-scan of cached sources; suppressed so
# vulnscan=enforce / srcguard=enforce builds pass. Review periodically;
# new findings still fail the build until reviewed.
vulnscan-ignore=GHSA-2pr8-phx7-x9h3,GHSA-2v37-7h3g-55p8,GHSA-48hr-524c-v5w3,GHSA-4cwx-7wf7-3272,GHSA-4g3v-8h47-v7g6,GHSA-5c6j-r48x-rmvq,GHSA-66ff-xgx4-vchm,GHSA-685m-2w69-288q,GHSA-75px-5xx7-5xc7,GHSA-7c4v-fwgw-9rf7,GHSA-7pw4-f3q4-r2p2,GHSA-8988-4f7v-96qf,GHSA-8xcm-r25x-g524,GHSA-9473-5f9j-94wq,GHSA-9pgf-384g-p7mv,GHSA-f38q-mgvj-vph7,GHSA-f48w-9m4c-m7f5,GHSA-f88m-g3jw-g9cj,GHSA-fx83-v9x8-x52w,GHSA-g7r4-m6w7-qqqr,GHSA-hmw2-7cc7-3qxx,GHSA-hxcr-hm88-mpq6,GHSA-hxvh-4h3w-prp9,GHSA-j3f2-48v5-ccww,GHSA-jggg-4jg4-v7c6,GHSA-jmr9-qjv8-65gv,GHSA-jr45-8vmc-qm54,GHSA-jvwf-75h9-cwgg,GHSA-m8rv-5g2x-5cg5,GHSA-q6x5-8v7m-xcrf,GHSA-qj8w-gfj5-8c6v,GHSA-v3r7-h72x-cjcm,GHSA-wcpc-wj8m-hjx6,GHSA-wm8w-6qjm-cv43,GHSA-xq3m-2v4x-88gg,GO-2026-5932,GO-2026-6179,GO-2026-6180,GO-2026-6222
