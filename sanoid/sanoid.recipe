[INFO]
arch=all

[VERSION]
B_GITVER https://github.com/jimsalterjrs/sanoid

[BUILD]
B_GET git https://github.com/jimsalterjrs/sanoid sanoid
cd sanoid
git checkout tags/v$B_VERSION
mkdir -p $B_INSTALLDIR/etc/sanoid $B_INSTALLDIR/usr/bin $B_INSTALLDIR/usr/share/doc/sanoid
cp sanoid.defaults.conf $B_INSTALLDIR/etc/sanoid
cp sanoid.conf $B_INSTALLDIR/etc/sanoid/sanoid.conf.example
cp findoid sanoid sleepymutex syncoid $B_INSTALLDIR/usr/bin
cp README.md $B_INSTALLDIR/usr/share/doc/sanoid

[PKG]
type=deb
torepo=y

[DEB]
Package: sanoid
Version: B_VERSION
Section: sanoid
Priority: optional
Architecture: B_ARCH
Maintainer: B_MAIL
Description: Sanoid custom B_ORG build
Homepage: https://github.com/jimsalterjrs/sanoid
Depends: zfsutils-linux | openzfs-zfsutils,libconfig-inifiles-perl,mbuffer,lzop,pv,openssh-client,libcapture-tiny-perl
