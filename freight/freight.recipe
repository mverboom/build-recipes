[INFO]
arch=amd64

[VERSION]
#ver=$( git ls-remote --tags https://github.com/freight-team/freight | grep -v '{}' | cut -d '/' -f 3 | sort | tail -1 ); echo ${ver/v/}
B_GITVER https://github.com/freight-team/freight

[REQUIRED]
make

[BUILD]
B_GET git https://github.com/freight-team/freight fr
cd fr
git checkout tags/v$B_VERSION
make -j $(nproc)
make install DESTDIR=$B_INSTALLDIR prefix=/opt/freight

[PKG]
type=deb
torepo=y

[DEB]
Package: freight
Version: B_VERSION
Section: freight
Priority: optional
Architecture: B_ARCH
Maintainer: B_MAIL
Description: Freight custom B_ORG build
Homepage: https://github.com/freight-team/freight

