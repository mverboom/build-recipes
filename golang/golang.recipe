[INFO]
arch=amd64

[VERSION]
B_GITVER -e weekly -f "^go" https://go.googlesource.com/go

[BUILD]
B_GET http https://go.dev/dl/go${B_VERSION}.linux-amd64.tar.gz go.tar.gz
mkdir -p $B_INSTALLDIR/opt
tar xzf go.tar.gz -C $B_INSTALLDIR/opt
B_LINKFILES /opt/go/bin /usr/bin

[PKG]
type=deb
torepo=y

[DEB]
Package: golang
Version: B_VERSION
Section: golang
Priority: optional
Architecture: B_ARCH
Maintainer: B_MAIL
Homepage: https://go.googlesource.com/go
Description: Golang B_ORG custom build

[SECURITY]
# Findings from security-scan of cached sources; suppressed so
# vulnscan=enforce / srcguard=enforce builds pass. Review periodically;
# new findings still fail the build until reviewed.
vulnscan-ignore=GHSA-23c5-xmqv-rm74,GHSA-25h7-pfq9-p65f,GHSA-28wg-ghj8-5hjv,GHSA-2g4f-4pwh-qvx6,GHSA-2v37-7h3g-55p8,GHSA-395f-4hp3-45gv,GHSA-3jxr-9vmj-r5cp,GHSA-3ppc-4f35-3m26,GHSA-3v7f-55p6-f55p,GHSA-3xgq-45jj-v275,GHSA-52cp-r559-cp3m,GHSA-5p4m-2wfm-xmqj,GHSA-6g55-p6wh-862q,GHSA-7fh5-64p2-3v2j,GHSA-7r86-cg39-jmmj,GHSA-952p-6rrq-rcjv,GHSA-c2c7-rcm5-vvqj,GHSA-f886-m6hf-6m8v,GHSA-fxqj-rqcc-2cmp,GHSA-grv7-fg5c-xmjg,GHSA-h67p-54hq-rp68,GHSA-mh29-5h37-fv8m,GHSA-mh99-v99m-4gvg,GHSA-mwcw-c2x4-8c55,GHSA-qx2v-qp2m-jg93,GHSA-r28c-9q8g-f849,GHSA-rf6f-7fwh-wjgh,GHSA-rgw5-rvv9-x895,GHSA-v6h2-p8h4-qcjw,GHSA-w7jw-789q-3m8p,GO-2026-5932,GO-2026-5942,GO-2026-5970,GO-2026-6179,GO-2026-6180
srcguard-ignore=go/lib/fips140/Makefile
