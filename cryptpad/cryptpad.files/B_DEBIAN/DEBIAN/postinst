#!/bin/sh
 
if test "$1" = "configure"; then
  # Create a cryptpad system group
  if ! getent group cryptpad > /dev/null; then
      addgroup --quiet --system cryptpad
  fi
  
  # Create a cryptpad system user
  if ! getent passwd cryptpad > /dev/null; then
      adduser --quiet --system \
          --ingroup cryptpad \
          --home /opt/cryptpad \
          --no-create-home \
          --disabled-password --shell /bin/bash \
          cryptpad
      usermod -c "Cryptpad user" cryptpad
  fi

  # Generate the instance's HTML pages (social-preview meta tags, preloading
  # versions) from config.js + infra.js. Writes into the persistent customize/
  # directory, which the server prefers over the packaged www/. Run as root
  # here; the chown below makes the generated files cryptpad-owned. Failure is
  # not fatal (e.g. a fresh install without config.js yet).
  if [ -f /etc/cryptpad/config.js ] && command -v node >/dev/null 2>&1; then
      ( cd /opt/cryptpad && node scripts/build.js ) >/dev/null 2>&1 || true
  fi

  chown -R cryptpad:cryptpad /var/lib/cryptpad /etc/cryptpad /var/log/cryptpad

  systemctl enable cryptpad
  systemctl start cryptpad
else
  systemctl restart cryptpad
fi
