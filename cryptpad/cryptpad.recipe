[INFO]
arch=amd64

[VERSION]
B_GITVER https://github.com/xwiki-labs/cryptpad

[REQUIRED]
nodejs-lts-B_PF
curl unzip
#nodejs npm

[BUILD]
B_GET git https://github.com/xwiki-labs/cryptpad cryptpad
cd cryptpad
git checkout $B_VERSION
npm install
# cryptpad-server 1.0.1 collapses second-stage command errors into a
# generic "Execution error" and the front only returns {error}, so the
# restricted-registration checkup (test 8) fails. Restore the real code.
node $B_FILES/patch-cpsrv.js
npm run install:components
# The 2026.9.0 client opens a document's checkpoint Office version when
# exporting/downloading, so old editors must keep shipping. install-office.sh
# defaults oldest_needed_version to v9, which drops v1-v8 and breaks exports of
# documents last saved under them (the nightly backup stalled on a v8 doc). Pin
# the range the estate has used since at least the 2024.12 package (v1-v7).
mkdir -p onlyoffice-conf
printf 'oldest_needed_version=v1\n' > onlyoffice-conf/onlyoffice.properties
ACCEPT_LICENSE=y ./install-office.sh
mkdir -p $B_INSTALLDIR/opt/cryptpad $B_INSTALLDIR/etc/cryptpad $B_INSTALLDIR/var/lib/cryptpad/datastore $B_INSTALLDIR/var/lib/cryptpad/data/pins $B_INSTALLDIR/var/lib/cryptpad/data/tasks $B_INSTALLDIR/var/lib/cryptpad/block $B_INSTALLDIR/var/lib/cryptpad/blob $B_INSTALLDIR/var/lib/cryptpad/data/blobstage $B_INSTALLDIR/var/lib/cryptpad/customize $B_INSTALLDIR/var/lib/cryptpad/plugins $B_INSTALLDIR/var/log/cryptpad
mv config/config.example.js config.js
sed -i '/filePath/ s#./#/var/lib/cryptpad/#' config.js
sed -i '/archivePath/ s#./#/var/lib/cryptpad/#' config.js
sed -i '/pinPath/ s#./#/var/lib/cryptpad/#' config.js
sed -i '/taskPath/ s#./#/var/lib/cryptpad/#' config.js
sed -i '/blockPath/ s#./#/var/lib/cryptpad/#' config.js
sed -i '/blobPath/ s#./#/var/lib/cryptpad/#' config.js
sed -i '/blobStagingPath/ s#./#/var/lib/cryptpad/#' config.js
sed -i '/logPath/ s#./data/logs#/var/log/cryptpad#' config.js
mv config.js $B_INSTALLDIR/etc/cryptpad/config.js.example
cp config/infra.example.js $B_INSTALLDIR/etc/cryptpad/infra.example.js
rm -f *.md
rm -rf .git* config
tar cf - . | ( cd $B_INSTALLDIR/opt/cryptpad ; tar xf - )
B_LINKFILES /var/lib/cryptpad /opt/cryptpad
ln -s /etc/cryptpad $B_INSTALLDIR/opt/cryptpad/config

[PKG]
type=deb
torepo=y

[DEB]
Package: cryptpad
Version: B_VERSION
Section: cryptpad
Priority: optional
Architecture: B_ARCH
Maintainer: B_MAIL
Description: Cryptpad custom B_ORG build
Homepage: https://cryptpad.fr/
Depends: nodejs-lts-B_PF

