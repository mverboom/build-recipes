[INFO]
arch=amd64

[VERSION]
B_GITVER -e 'dev' https://github.com/go-gitea/gitea.git

[REQUIRED]
make golang-B_PF libpam0g-dev gcc  nodejs-22-B_PF pnpm-B_PF

[BUILD]
export GOROOT=/opt/go
export PATH=${PATH}:${GOROOT}/bin
B_GET git https://github.com/go-gitea/gitea.git gitea
cd gitea
git checkout v$B_VERSION
TAGS="bindata sqlite sqlite_unlock_notify pam" make build
mkdir -p $B_INSTALLDIR/opt/gitea/
tar cfB - public templates gitea | ( cd $B_INSTALLDIR/opt/gitea ; tar xfB - )
B_LINKFILE /opt/gitea/gitea /usr/bin

[PKG]
type=deb
torepo=y

[DEB]
Package: gitea
Version: B_VERSION
Section: gitea
Priority: optional
Architecture: B_ARCH
Maintainer: B_MAIL
Homepage: https://gitea.io
Description: Gitea B_PF custom build
Depends: git

[SECURITY]
# Findings from security-scan of cached sources; suppressed so
# vulnscan=enforce / srcguard=enforce builds pass. Review periodically;
# new findings still fail the build until reviewed.
vulnscan-ignore=GHSA-2v37-7h3g-55p8,GHSA-3jxr-9vmj-r5cp,GHSA-4c8g-83qw-93j6,GHSA-52cp-r559-cp3m,GHSA-55q2-fjhq-7xh7,GHSA-5p4m-2wfm-xmqj,GHSA-7p8r-x3mc-p8w7,GHSA-c2j3-45gr-mqc4,GHSA-cmwh-pvxp-8882,GHSA-gvmj-g25r-r7wr,GHSA-hmw2-7cc7-3qxx,GHSA-mh99-v99m-4gvg,GHSA-rgw5-rvv9-x895,GHSA-v2hh-gcrm-f6hx,GHSA-vxr8-fq34-vvx9,GO-2026-5932,GO-2026-6179,GO-2026-6180,GO-2026-6222
