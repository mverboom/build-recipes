[INFO]
arch=all

[VERSION]
B_GITVER https://github.com/reloxx13/TasmoAdmin

[BUILD]
B_GET git https://github.com/reloxx13/TasmoAdmin tasmoadmin
cd tasmoadmin
git checkout v$B_VERSION
mkdir -p $B_INSTALLDIR/opt/tasmoadmin
mkdir -p $B_INSTALLDIR/var/lib/tasmoadmin/
cd tasmoadmin
mv tmp data $B_INSTALLDIR/var/lib/tasmoadmin
ln -s /var/lib/tasmoadmin/tmp tmp
ln -s /var/lib/tasmoadmin/data data
tar cf - . | (cd $B_INSTALLDIR/opt/tasmoadmin ; tar xf - )

[PKG]
type=deb
torepo=y

[DEB]
Package: tasmoadmin
Version: B_VERSION
Section: tasmoadmin
Priority: optional
Architecture: B_ARCH
Maintainer: B_MAIL
Description: Tasmoadmin custom B_ORG build
Homepage: https://github.com/reloxx13/TasmoAdmin
Depends: php-zip

[SECURITY]
# Findings from security-scan of cached sources; suppressed so
# vulnscan=enforce / srcguard=enforce builds pass. Review periodically;
# new findings still fail the build until reviewed.
vulnscan-ignore=GHSA-29pj-957v-52mc,GHSA-2q4p-g7hv-5rgv,GHSA-3jxr-9vmj-r5cp,GHSA-f7vp-7xgx-4w4r,GHSA-g2gp-3wwq-f4ph,GHSA-jfm3-95jq-q3rf,GHSA-mh25-x5hq-wrqp,GHSA-mh99-v99m-4gvg,GHSA-mj63-m3rc-8ppr,GHSA-rgw5-rvv9-x895,GHSA-v56q-mh7h-f735,GHSA-v5mv-p594-2x33,GHSA-xvcm-6775-5m9r
