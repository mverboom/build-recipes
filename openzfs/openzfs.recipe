[VERSION]
B_GITVER -D -r s/zfs-// -f .\..\.99 https://github.com/openzfs/zfs

[INFO]
arch=amd64
# Tag is zfs-<version>, not v<version> or <version>; the build system's
# shallow-clone refresh only fetches v$B_VERSION / $B_VERSION tags, so tell
# it the exact tag name to fetch for checkout.
gittag=zfs-$B_VERSION

[REQUIRED]
build-essential autoconf automake libtool gawk alien fakeroot dkms libblkid-dev uuid-dev libudev-dev libssl-dev zlib1g-dev libaio-dev libattr1-dev libelf-dev python3 python3-dev python3-setuptools python3-cffi libffi-dev python3-packaging dh-python libcurl4-openssl-dev python3-all-dev python3-sphinx libpam0g-dev dh-dkms

[REQUIRED DEBIAN TRIXIE]
build-essential autoconf automake libtool gawk alien fakeroot dkms libblkid-dev uuid-dev libudev-dev libssl-dev zlib1g-dev libaio-dev libattr1-dev libelf-dev python3 python3-dev python3-setuptools python3-cffi libffi-dev python3-packaging dh-python libcurl4-openssl-dev python3-all-dev python3-sphinx libpam0g-dev dh-dkms libtirpc-dev linux-headers-amd64

[PKG]
type=deb
pkgready=1
torepo=1

[BUILD]
B_GET git https://github.com/openzfs/zfs zfs
cd zfs
git checkout zfs-${B_VERSION}
sed -i "s/@VERSION@-1/@VERSION@-1+deb$(lsb_release -r -s | cut -d'.' -f 1)/" contrib/debian/changelog.in
./autogen.sh
./configure --enable-systemd
make native-deb
#make native-deb-kmod
cp ../*.deb ${B_INSTALLDIR}
# contrib/debian/changelog.in +deb13 @VERSION@-1

[SECURITY]
# Findings from security-scan of cached sources; suppressed so
# vulnscan=enforce / srcguard=enforce builds pass. Review periodically;
# new findings still fail the build until reviewed.
srcguard-ignore=zfs/config/user-libfetch.m4,zfs/configure,zfs/debian/openzfs-zfs-dkms/usr/src/zfs-2.4.4/config/user-libfetch.m4,zfs/debian/openzfs-zfs-dkms/usr/src/zfs-2.4.4/configure,zfs/zfs-2.4.4/configure
