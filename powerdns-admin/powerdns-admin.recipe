[VERSION]
B_GITHUBVER https://github.com/alsyundawy/PowerDNS-Admin
#B_GITVER https://github.com/PowerDNS-Admin/PowerDNS-Admin.git 

[INFO]
arch=amd64

[REQUIRED]
python3-dev python3-pip python3-venv yarn-B_PF npm libsasl2-dev libldap2-dev libmariadb-dev pkg-config build-essential curl libpq-dev libxmlsec1-dev 

[BUILD]
# pyyaml 5.3.1
#B_GET git https://github.com/PowerDNS-Admin/PowerDNS-Admin.git powerdns-admin
B_GET git https://github.com/alsyundawy/PowerDNS-Admin powerdns-admin
cd powerdns-admin
#git checkout v$B_VERSION
# Remove alsyundawy IT Solution promotion from templates
patch -p1 < $B_FILES/remove-alsyundawy-promo.patch
# Remove version-string branding from base.html footer (version-agnostic so version bumps don't break the patch)
sed -i 's/ Modified By Alsyundawy//' powerdnsadmin/templates/base.html
# Remove unused dead variant templates containing alsyundawy branding
rm -f powerdnsadmin/templates/[0-9]*.html
# Remove custom alsyundawy logo files (original PDA has no logo.png)
rm -f powerdnsadmin/static/img/logo*.png
DIR=opt/powerdns-admin
DEST=$B_INSTALLDIR/$DIR
mkdir -p "$DEST"
python3 -m venv $DEST
source $DEST/bin/activate
pip3 install flask
pip3 install -r requirements.txt
# Configure file?
cp configs/development.py configs/production.py
export FLASK_CONF=../configs/production.py
export FLASK_APP=powerdnsadmin/__init__.py
yarn install --pure-lockfile

# Python 3.13 doesn't have imghdr anymore
sed -i 's/import imghdr/#import imghdr/' powerdnsadmin/routes/user.py
flask assets build
rm -rf .git docs docker docker-test
rm -f requirements.txt *.md LICENSE docker-compose-* VERSION docker-compose.yml

deactivate
var="$B_INSTALLDIR/var/lib/powerdns-admin"
mkdir -p "$var"
mv migrations "$var"
ln -s /var/lib/powerdns-admin/migrations migrations
mv powerdnsadmin/static/.webassets-cache "$var/webassets-cache"
ln -s /var/lib/powerdns-admin/webassets-cache powerdnsadmin/static/.webassets-cache
mv * "$DEST"

cd "$DEST/bin"
shopt -s extglob
sed -i "s|$DEST|/opt/powerdns-admin|g" !(__pycache__)

# su -s /bin/bash pdnsadmin
# . /etc/default/powerdns-admin
# export FLASK_CONF FLASK_APP
# /opt/powerdns-admin/bin/flask db upgrade

[PKG]
type=deb
torepo=y

[DEB]
Package: powerdns-admin
Version: B_VERSION
Section: powerdns-admin
Priority: optional
Architecture: B_ARCH
Maintainer: B_MAIL
Description: powerdns-admin custom B_ORG build
Homepage: https://github.com/PowerDNS-Admin/PowerDNS-Admin.git 
