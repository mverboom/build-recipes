# Termix is served under /termix/ behind this TLS-terminating nginx. The
# backend on 127.0.0.1:30001 serves the frontend, the core API and every
# plugin route (/plugin-api/, /plugin-ws/) plus plugin assets
# (/plugin-assets/). nginx terminates TLS, caches the hashed build assets and
# strips the /termix prefix before proxying everything else to the backend.

map $http_upgrade $connection_upgrade {
    default upgrade;
    ""      close;
}

server {
    listen 443 default_server ssl;
    listen [::]:443 default_server ssl;

    ssl_certificate /etc/le/lnw.verboom.net/nginx/fullchain.pem;
    ssl_certificate_key /etc/le/lnw.verboom.net/nginx/privkey.pem;

    add_header X-Content-Type-Options nosniff always;

    # Hashed build assets and static files, cached directly by nginx.
    location ^~ /termix/assets/ {
        alias /opt/termix/dist/assets/;
        expires 1y;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
    }

    location ^~ /termix/fonts/ {
        alias /opt/termix/dist/fonts/;
        expires 1y;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
    }

    location ^~ /termix/icons/ {
        alias /opt/termix/dist/icons/;
        expires 1y;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
    }

    location = /termix/sw.js {
        alias /opt/termix/dist/sw.js;
        expires off;
        add_header Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0" always;
    }

    location = /termix/manifest.json {
        alias /opt/termix/dist/manifest.json;
        expires off;
        add_header Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0" always;
    }

    # Everything else: index.html, SPA routes, the core API and all plugin
    # HTTP/WebSocket routes, all on the one backend port.
    location /termix/ {
        proxy_pass http://127.0.0.1:30001/;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_cache_bypass $http_upgrade;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
        client_max_body_size 0;
    }

    location = /termix { return 301 /termix/; }
    location = / { return 302 /termix/; }
}
