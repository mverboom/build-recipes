[INFO]
arch=amd64

[VERSION]
B_GITVER -r "s/^v//" -r "s/^release-//" -r "s/-tag$//" https://github.com/Termix-SSH/Termix

[REQUIRED]
nodejs-lts-B_PF python3 make g++

[BUILD]
B_GET git https://github.com/Termix-SSH/Termix termix
cd termix
git checkout v$B_VERSION

# Install all dependencies (incl. build tools), but skip npm lifecycle
# scripts: upstream docker/Dockerfile does the same and applies only the ssh2
# patch explicitly for the server.
npm ci --ignore-scripts
node scripts/patch-ssh2-agent.cjs

# Build frontend (Vite), backend (tsc), plugin SDK and bundled plugins.
# VITE_BASE_PATH=/termix/ because the app runs behind a reverse proxy subpath.
export VITE_BASE_PATH=/termix/
NODE_OPTIONS="--max-old-space-size=3072" npm run build

# The container image injects the base path into the shell at run time; bake it
# in here instead, so /termix/sw.js and the shell know where they are served.
TERMIX_BASE="${VITE_BASE_PATH%/}"
sed -i "s|__TERMIX_SW_BASE_PATH__|$TERMIX_BASE|g" dist/sw.js
sed -i "s|name=\"termix-base-path\" content=\"\"|name=\"termix-base-path\" content=\"$TERMIX_BASE\"|g" dist/index.html

# Production dependencies only, mirroring docker/Dockerfile production-deps:
# build better-sqlite3 from source and rebuild the other native modules.
rm -rf node_modules
npm ci --omit=dev --ignore-scripts
node scripts/patch-ssh2-agent.cjs
rm -rf node_modules/better-sqlite3/prebuilds
npm run build-release --prefix node_modules/better-sqlite3
npm rebuild bcryptjs ssh2

# dist/ holds the frontend plus dist/backend (server) and dist/plugins
# (the bundled plugin artifacts).
mkdir -p $B_INSTALLDIR/opt/termix/dist
cp -r dist/* $B_INSTALLDIR/opt/termix/dist/

# Runtime dependencies and metadata.
cp -r node_modules $B_INSTALLDIR/opt/termix/
cp package.json $B_INSTALLDIR/opt/termix/
cp -r drizzle $B_INSTALLDIR/opt/termix/

# The @termix-ssh/plugin-sdk workspace package: node_modules/@termix-ssh/plugin-sdk
# is a symlink to ../../packages/plugin-sdk and the backend imports its subpaths.
mkdir -p $B_INSTALLDIR/opt/termix/packages/plugin-sdk
cp packages/plugin-sdk/package.json $B_INSTALLDIR/opt/termix/packages/plugin-sdk/
cp -r packages/plugin-sdk/dist $B_INSTALLDIR/opt/termix/packages/plugin-sdk/

# Data and log directories
mkdir -p $B_INSTALLDIR/var/lib/termix
mkdir -p $B_INSTALLDIR/var/log/termix

[PKG]
type=deb
torepo=y

[DEB]
Package: termix
Version: B_VERSION
Section: termix
Priority: optional
Architecture: B_ARCH
Maintainer: B_MAIL
Description: Termix SSH and remote desktop management B_ORG build
Homepage: https://github.com/Termix-SSH/Termix
Depends: nodejs-lts-B_PF, nginx, guacamole-server-B_PF
