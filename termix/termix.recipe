[INFO]
arch=amd64
gittag=release-$B_VERSION-tag

[VERSION]
B_GITVER -r 's/^release-//' -r 's/-tag$//' https://github.com/Termix-SSH/Termix

[REQUIRED]
nodejs-lts-B_PF python3 make g++

[BUILD]
B_GET git https://github.com/Termix-SSH/Termix termix
cd termix
git checkout release-$B_VERSION-tag

# Install all dependencies and build frontend + backend
npm ci
# Build frontend with subpath base /termix/ so OIDC callbacks and
# frontend routes work correctly behind reverse proxy at /termix/
export VITE_BASE_PATH=/termix/

npm run build

# Switch to production dependencies only
rm -rf node_modules
npm ci --omit=dev --ignore-scripts
npm rebuild better-sqlite3 bcryptjs

# Copy entire dist output (frontend + backend) to /opt/termix/dist/
# The backend serves frontend via express.static from process.cwd()/dist
# Locales and fonts are bundled into dist by Vite since 2.3.0
mkdir -p $B_INSTALLDIR/opt/termix/dist
cp -r dist/* $B_INSTALLDIR/opt/termix/dist/

# Install production dependencies and package.json
cp -r node_modules $B_INSTALLDIR/opt/termix/
cp package.json $B_INSTALLDIR/opt/termix/

# Data and log directories
mkdir -p $B_INSTALLDIR/var/lib/termix/uploads
mkdir -p $B_INSTALLDIR/var/log/termix

# Symlink uploads into /opt/termix so the hardcoded path works via /var
ln -s /var/lib/termix/uploads $B_INSTALLDIR/opt/termix/uploads

[PKG]
type=deb
torepo=y

[DEB]
Package: termix
Version: B_VERSION
Section: termix
Priority: optional
Architecture: B_ARCH
Maintainer: B_MAIL
Description: Termix SSH and remote desktop management B_ORG build
Homepage: https://github.com/Termix-SSH/Termix
Depends: nodejs-lts-B_PF, nginx, guacamole-server-B_PF

[SECURITY]
# Findings from security-scan of cached sources; suppressed so
# vulnscan=enforce / srcguard=enforce builds pass. Review periodically;
# new findings still fail the build until reviewed.
vulnscan-ignore=GHSA-23hp-3jrh-7fpw,GHSA-28wg-ghj8-5hjv,GHSA-2v37-7h3g-55p8,GHSA-35jp-ww65-95wh,GHSA-35p6-xmwp-9g52,GHSA-395f-4hp3-45gv,GHSA-3jxr-9vmj-r5cp,GHSA-3p4h-7m6x-2hcm,GHSA-42h9-826w-cgv3,GHSA-4c8g-83qw-93j6,GHSA-4cwx-7wf7-3272,GHSA-4x5r-pxfx-6jf8,GHSA-52cp-r559-cp3m,GHSA-58qx-3vcg-4xpx,GHSA-5p4m-2wfm-xmqj,GHSA-654m-c8p4-x5fp,GHSA-6g55-p6wh-862q,GHSA-72gw-mp4g-v24j,GHSA-777c-7fjr-54vf,GHSA-7g7r-gx96-252g,GHSA-7p8r-x3mc-p8w7,GHSA-7q8q-rj6j-mhjq,GHSA-898c-q2cr-xwhg,GHSA-8x88-c5mf-7j5w,GHSA-8xcm-r25x-g524,GHSA-96hv-2xvq-fx4p,GHSA-9f4c-93c8-jc8g,GHSA-f4gw-2p7v-4548,GHSA-fx2h-pf6j-xcff,GHSA-fxqj-rqcc-2cmp,GHSA-g8m3-5g58-fq7m,GHSA-gcfj-64vw-6mp9,GHSA-gvwx-54wh-qm9j,GHSA-h67p-54hq-rp68,GHSA-hcpx-6fm6-wx23,GHSA-hfxv-24rg-xrqf,GHSA-hm92-r4w5-c3mj,GHSA-hmw2-7cc7-3qxx,GHSA-j5f8-grm9-p9fc,GHSA-jmr9-qjv8-65gv,GHSA-jqh4-m9w3-8hp9,GHSA-jr45-8vmc-qm54,GHSA-jxxr-4gwj-5jf2,GHSA-m8rv-5g2x-5cg5,GHSA-mh99-v99m-4gvg,GHSA-mmx7-hfxf-jppx,GHSA-mwf2-3pr3-8698,GHSA-mwp4-54f8-5fhr,GHSA-p2f4-r6v6-j797,GHSA-p88m-4jfj-68fv,GHSA-p92q-9vqr-4j8v,GHSA-ph9p-34f9-6g65,GHSA-pjwm-pj3p-43mv,GHSA-pmv8-rq9r-6j72,GHSA-pr7r-676h-xcf6,GHSA-q3j6-qgpj-74h6,GHSA-q8mj-m7cp-5q26,GHSA-r28c-9q8g-f849,GHSA-r292-9mhp-454m,GHSA-r4w5-6pfg-jxp5,GHSA-rgw5-rvv9-x895,GHSA-v2hh-gcrm-f6hx,GHSA-v2v4-37r5-5v8g,GHSA-v39h-62p7-jpjc,GHSA-v3j7-r9gq-3gjw,GHSA-v3r7-h72x-cjcm,GHSA-v422-hmwv-36x6,GHSA-v6wh-96g9-6wx3,GHSA-vmf3-w455-68vh,GHSA-vmh5-mc38-953g,GHSA-vxpw-j846-p89q,GHSA-w7jw-789q-3m8p,GHSA-w8wr-v893-vjvp,GHSA-xj6q-8x83-jv6g
