[INFO]
arch=amd64
excludefromall=1

[VERSION]
B_GITVER -f 9.9.9 -i 2. https://github.com/influxdata/influxdb

[REQUIRED]
golang-B_PF gotools-B_PF make dep-B_PF asciidoc pkg-config protobuf-compiler protoc-gen-go tmpl gcc rustc-B_PF

[BUILD]
export PATH=/opt/go/bin:${PATH}

B_GET git https://github.com/influxdata/influxdb influxdb
cd influxdb
git checkout v$B_VERSION
make
mkdir -p $B_INSTALLDIR/opt/influxdb/bin
cp bin/linux/influxd $B_INSTALLDIR/opt/influxdb/bin
B_LINKFILES /opt/influxdb/bin /usr/bin

[PKG]
type=deb
torepo=y

[DEB]
Package: influxdb
Version: B_VERSION
Section: influxdb
Priority: optional
Architecture: B_ARCH
Maintainer: B_MAIL
Description: Influxdb custom B_ORG build
Homepage: https://www.influxdata.com/
Depends: influx-cli-B_PF

[SECURITY]
# Findings from security-scan of cached sources; suppressed so
# vulnscan=enforce / srcguard=enforce builds pass. Review periodically;
# new findings still fail the build until reviewed.
vulnscan-ignore=GHSA-2f9f-gq7v-9h6m,GHSA-2r75-cxrj-cmph,GHSA-394w-hwhg-8vgm,GHSA-4w2j-m93h-cj5j,GHSA-6wgr-89rj-399p,GHSA-82j2-j2ch-gfr8,GHSA-965h-392x-2mh5,GHSA-f984-pcp8-v2p7,GHSA-hx6p-xpx3-jvvv,GHSA-jhxm-h53p-jm7w,GHSA-jxhv-7h78-9775,GHSA-m758-wjhj-p3jq,GHSA-m9w2-8782-2946,GHSA-p8xm-42r7-89xg,GHSA-pwjx-qhcg-rvj4,GHSA-q49f-xg75-m9xw,GHSA-qqfj-4vcm-26hv,GHSA-xgp8-3hg3-c2mh,GHSA-xx5w-cvp6-jv83,RUSTSEC-2023-0071,RUSTSEC-2024-0436,RUSTSEC-2025-0012,RUSTSEC-2025-0134,RUSTSEC-2025-0141,RUSTSEC-2026-0049,RUSTSEC-2026-0085,RUSTSEC-2026-0086,RUSTSEC-2026-0087,RUSTSEC-2026-0088,RUSTSEC-2026-0089,RUSTSEC-2026-0091,RUSTSEC-2026-0092,RUSTSEC-2026-0093,RUSTSEC-2026-0094,RUSTSEC-2026-0095,RUSTSEC-2026-0096,RUSTSEC-2026-0098,RUSTSEC-2026-0099,RUSTSEC-2026-0104,RUSTSEC-2026-0114,RUSTSEC-2026-0149,RUSTSEC-2026-0182,RUSTSEC-2026-0185,RUSTSEC-2026-0188,RUSTSEC-2026-0194,RUSTSEC-2026-0195,RUSTSEC-2026-0221,RUSTSEC-2026-0222,RUSTSEC-2026-0235,RUSTSEC-2026-0258
