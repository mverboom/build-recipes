[INFO]
arch=amd64

[VERSION]
B_GITHUBVER https://github.com/javadmohebbi/goNfCollector

[REQUIRED]
golang-B_PF

[BUILD]
export GOROOT=/opt/go
export PATH=/opt/go/bin:${PATH}
export GOPATH=$(pwd)

B_GET git https://github.com/javadmohebbi/goNfCollector gonfcollector
cd gonfcollector
sed -i 's#"/opt/oi24/netflow-collector/etc/"#"/etc/nfcollector/"#' cmd/collector/main.go
go build -o nfcollector cmd/collector/main.go
sed -i 's#"/opt/nfcollector/etc/"#"/etc/nfcollector/"#' cmd/updater/main.go
go build -o nfupdater cmd/updater/main.go
dst="$B_INSTALLDIR/opt/nfcollector"
mkdir -p "$dst/bin" "$B_INSTALLDIR/etc/nfcollector" "$B_INSTALLDIR/var/log/nfcollector" "$B_INSTALLDIR/var/lib/nfcollector/ipsum"
cp templates/configs-example/* "$B_INSTALLDIR/etc/nfcollector"
cp templates/ipsum/ipsum.txt "$B_INSTALLDIR/var/lib/nfcollector/ipsum"
mv nfcollector "$dst/bin"
mv nfupdater "$dst/bin"
B_LINKFILES /opt/nfcollector/bin /usr/bin

# ToDo:
# - configfiles include
# - generate application user
# - chown required files
# - systemd files?

[PKG]
type=deb
torepo=y

[DEB]
Package: gonfcollector
Version: B_VERSION
Section: gonfcollector
Priority: optional
Architecture: B_ARCH
Maintainer: B_MAIL
Description: Gonfcollector custom B_ORG build
Homepage: https://github.com/javadmohebbi/goNfCollector

[SECURITY]
# Findings from security-scan of cached sources; suppressed so
# vulnscan=enforce / srcguard=enforce builds pass. Review periodically;
# new findings still fail the build until reviewed.
vulnscan-ignore=GHSA-2328-f5f3-gj25,GHSA-23c5-xmqv-rm74,GHSA-23hp-3jrh-7fpw,GHSA-25h7-pfq9-p65f,GHSA-28wg-ghj8-5hjv,GHSA-2g4f-4pwh-qvx6,GHSA-2m8v-j782-fhvr,GHSA-2p49-hgcm-8545,GHSA-2p57-rm9w-gvfp,GHSA-2r2c-g63r-vccr,GHSA-2v37-7h3g-55p8,GHSA-2wrh-6pvc-2jm9,GHSA-33f9-j839-rf8h,GHSA-34x7-hfp2-rc4v,GHSA-35jh-r3h4-6jhm,GHSA-378v-28hj-76wf,GHSA-37ch-88jc-xwx2,GHSA-395f-4hp3-45gv,GHSA-3g43-6gmg-66jw,GHSA-3h5v-q93c-6h6q,GHSA-3jxr-9vmj-r5cp,GHSA-3p68-rc4w-qgx5,GHSA-3ppc-4f35-3m26,GHSA-3rfm-jhwj-7488,GHSA-3v7f-55p6-f55p,GHSA-3xgq-45jj-v275,GHSA-434g-2637-qmqr,GHSA-4374-p667-p6c8,GHSA-43fc-jf86-j433,GHSA-45gg-vh54-h5m9,GHSA-45x7-px36-x8w8,GHSA-48c2-rrv3-qjmp,GHSA-49q7-c7j4-3p7m,GHSA-4f99-4q7p-p3gh,GHSA-4gmj-3p3h-gm8h,GHSA-4v7x-pqxf-cx7m,GHSA-4v9v-hfq4-rm2v,GHSA-4wf5-vphf-c2xc,GHSA-4x5r-pxfx-6jf8,GHSA-52cp-r559-cp3m,GHSA-554w-wpv2-vw27,GHSA-5c6j-r48x-rmvq,GHSA-5c9x-8gcm-mpgx,GHSA-5cgq-3rg8-m6cv,GHSA-5cv4-jp36-h3mw,GHSA-5gfm-wpxj-wjgq,GHSA-5m6q-g25r-mvwx,GHSA-5p4m-2wfm-xmqj,GHSA-5rrq-pxf6-6jx5,GHSA-62hf-57xw-28j9,GHSA-64mm-vxmg-q3vj,GHSA-65ch-62r8-g69g,GHSA-677m-j7p3-52f9,GHSA-67hx-6x53-jw92,GHSA-69cg-p879-7622,GHSA-69ch-w2m2-3vjp,GHSA-6chq-wfr3-2hj9,GHSA-6fx8-h7jm-663j,GHSA-6g55-p6wh-862q,GHSA-6rw7-vpxm-498p,GHSA-72mh-269x-7mh5,GHSA-72xf-g2v4-qvf3,GHSA-76c9-3jph-rj3q,GHSA-76p3-8jx3-jpfq,GHSA-78mq-xcr3-xm33,GHSA-78xj-cgh5-2h22,GHSA-79cf-xcqc-c78w,GHSA-7fh5-64p2-3v2j,GHSA-7jwh-3vrq-q3m8,GHSA-7q8q-rj6j-mhjq,GHSA-7r86-cg39-jmmj,GHSA-83g2-8m93-v3w7,GHSA-83g3-92jg-28cx,GHSA-848j-6mx2-7j84,GHSA-898c-q2cr-xwhg,GHSA-89gr-r52h-f8rx,GHSA-8c26-wmh5-6g9v,GHSA-8fr3-hfg3-gpgp,GHSA-8qq5-rm4j-mr97,GHSA-8x88-c5mf-7j5w,GHSA-93q8-gq69-wqmw,GHSA-952p-6rrq-rcjv,GHSA-95m3-7q98-8xr5,GHSA-968p-4wvh-cqc8,GHSA-96hv-2xvq-fx4p,GHSA-977x-g7h5-7qgw,GHSA-9c47-m6qq-7p4h,GHSA-9jgg-88mc-972h,GHSA-9m57-25v3-79x9,GHSA-9ppj-qmqm-q256,GHSA-9wv6-86v2-598j,GHSA-c2c7-rcm5-vvqj,GHSA-c2qf-rxjj-qqgw,GHSA-c36v-fmgq-m8hx,GHSA-c7qv-q95q-8v27,GHSA-cfm4-qjh2-4765,GHSA-cm22-4g7w-348p,GHSA-cpq7-6gpm-g9rc,GHSA-cqmj-92xf-r6r9,GHSA