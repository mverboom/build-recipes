[INFO]
arch=amd64

[VERSION]
B_GITVER https://github.com/microsoft/TypeScript

[REQUIRED]
nodejs-B_PF gulp-B_PF

[BUILD]
B_GET git https://github.com/microsoft/TypeScript typescript
cd typescript
git checkout v$B_VERSION
rm -rf .git .github doc node_modules src tests .vscode
#npm ci
#gulp local
#cd built/local
mkdir -p $B_INSTALLDIR/opt/typescript
tar cfB - . | ( cd $B_INSTALLDIR/opt/typescript ; tar xfB - )
B_LINKFILES /opt/typescript/bin /usr/bin

[PKG]
type=deb
torepo=y

[DEB]
Package: typescript
Version: B_VERSION
Section: typscript
Priority: optional
Architecture: B_ARCH
Maintainer: B_MAIL
Description: typscript custom B_ORG build
Homepage: https://www.typescriptlang.org
Depends: nodejs-B_PF

[SECURITY]
# Findings from security-scan of cached sources; suppressed so
# vulnscan=enforce / srcguard=enforce builds pass. Review periodically;
# new findings still fail the build until reviewed.
vulnscan-ignore=GHSA-cp6g-7hqx-qxhp,GHSA-mpwr-8vm7-h73f,GHSA-xcpc-8h2w-3j85,GHSA-xmrv-pmrh-hhx2,GO-2026-5052,GO-2026-5327,GO-2026-5764,GO-2026-5841,GO-2026-5932,GO-2026-5970,GO-2026-6179,GO-2026-6180
